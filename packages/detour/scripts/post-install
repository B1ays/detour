#!/bin/sh
[ -n "$IPKG_INSTROOT" ] && exit 0
[ -f /etc/uci-defaults/90-detour ] && ( . /etc/uci-defaults/90-detour ) && rm -f /etc/uci-defaults/90-detour
grep -qs '/usr/libexec/detour/watchdog' /etc/crontabs/root || { mkdir -p /etc/crontabs; echo '*/2 * * * * /usr/libexec/detour/watchdog' >> /etc/crontabs/root; /etc/init.d/cron restart; }
/etc/init.d/detour-fw enable
/etc/init.d/detour enable
/etc/init.d/detour-fw start
/etc/init.d/detour start
exit 0
