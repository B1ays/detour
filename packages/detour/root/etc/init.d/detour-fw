#!/bin/sh /etc/rc.common
# Detour routing core: nftables table "inet detour", ip rules, fail-closed routing tables.
# Runs before dnsmasq (S19) so the nftset targets exist before dnsmasq starts filling them,
# and restores the saved domain sets. Stop saves them (shutdown) and removes the table.

START=18
STOP=89

start() {
	/usr/libexec/detour/fw start
}

stop() {
	/usr/libexec/detour/fw stop
}

# rc.common would run stop+start: the table would be gone for a moment and policy traffic would leak.
restart() {
	/usr/libexec/detour/fw start
}

reload() {
	/usr/libexec/detour/fw start
}
