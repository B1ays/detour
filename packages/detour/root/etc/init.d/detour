#!/bin/sh /etc/rc.common
# Detour daemon (exit health, policy switching, DNS fallback) + direct encrypted DNS fallback resolver.

START=95
STOP=10
USE_PROCD=1

dnsproxy_instance() {
	local dns port
	config_get dns main dns off
	[ "$dns" = tunnel ] || [ "$dns" = encrypted ] || return 0
	# OpenWrt's package puts it in /usr/bin, GL.iNet's firmware in /usr/sbin (core.dnsproxy_bin)
	local bin=/usr/bin/dnsproxy
	[ -x $bin ] || bin=/usr/sbin/dnsproxy
	[ -x $bin ] || return 0
	# the user OpenWrt's package makes; a dnsproxy without it (GL.iNet's) gets it here
	user_exists dnsproxy || { local g=$(group_add_next dnsproxy); user_add dnsproxy "$g" "$g" dnsproxy /var/run /bin/false; }
	grep -q '^dnsproxy:' /etc/passwd || return 0
	config_get port main dns_fallback_port 5354
	procd_open_instance dnsfb
	# runs as user "dnsproxy": its traffic is exempt from policy routing (meta skuid), goes direct
	procd_set_param command $bin -l 127.0.0.1 -p "$port" --cache --upstream-mode=parallel
	local up bs got=
	config_get up main dns_fallback
	[ -n "$up" ] || up="quic://dns.adguard-dns.com tls://1.1.1.1 https://dns.google/dns-query"
	for u in $up; do procd_append_param command -u "$u"; done
	config_get bs main dns_bootstrap
	[ -n "$bs" ] || bs="9.9.9.9:53"
	for b in $bs; do procd_append_param command -b "$b"; done
	procd_set_param user dnsproxy
	procd_set_param group dnsproxy
	[ -f /etc/capabilities/dnsproxy.json ] && procd_set_param capabilities /etc/capabilities/dnsproxy.json
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

engine_instances() {
	local f=/tmp/detour/engines.list name bin args
	/usr/sbin/detour engines > $f 2>/tmp/detour/engines.err
	while IFS='	' read -r name bin args; do
		[ -n "$name" ] || continue
		procd_open_instance "engine_$name"
		procd_set_param command $bin $args
		# restart the engine when its generated config changes
		procd_set_param file /tmp/detour/engines/$name.json
		procd_set_param respawn 3600 5 0
		procd_set_param stderr 1
		procd_close_instance
	done < $f
}

start_service() {
	config_load detour
	local enabled
	config_get_bool enabled main enabled 1
	# switched off: no instances, and the routing core is taken down too (everything goes directly)
	[ "$enabled" = 1 ] || { /usr/libexec/detour/fw start; return 0; }
	# switched on again after that: the table has to be back before the daemon and the engines
	nft -t list table inet detour >/dev/null 2>&1 || /usr/libexec/detour/fw start
	mkdir -p /tmp/detour
	procd_open_instance detourd
	procd_set_param command /usr/sbin/detourd
	procd_set_param respawn 3600 2 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	dnsproxy_instance
	engine_instances
}

service_triggers() {
	procd_add_reload_trigger detour
}

reload_service() {
	ubus call detour reload >/dev/null 2>&1 || restart
	# dnsproxy instance may have to appear/disappear
	start
}
