#!/usr/bin/ucode
// detourd: exit health, policy -> exit selection, routes on netifd events, DNS fallback, 2FA guard.
// ubus object "detour": status, reload, pin {policy, exit}, unpin {policy}, switch (= pin).
'use strict';

import * as uloop from 'uloop';
import * as ubus from 'ubus';
import * as fs from 'fs';
import * as core from 'detour.core';
import * as nft from 'detour.nft';
import * as net from 'detour.net';
import * as dns from 'detour.dns';
import * as fw from 'detour.fw';
import * as auth from 'detour.auth';
import * as notify from 'detour.notify';
import * as socks from 'detour.socks';
import * as engines from 'detour.engines';
import * as exitui from 'detour.exitui';
import * as exitadd from 'detour.exitadd';
import * as watch from 'detour.watch';
import * as sitecheck from 'detour.sitecheck';
import * as dnsprov from 'detour.dnsprov';
import * as traffic from 'detour.traffic';
import * as dnswatch from 'detour.dnswatch';
import * as devices from 'detour.devices';
import { cursor } from 'uci';
import * as listmem from 'detour.listmem';
import * as pkgs from 'detour.pkgs';
import { _ } from 'detour.i18n';

const t0 = time();
let cfg, active, pins;
let health = {};          // exit name -> { ok, fails, seen, last_ok, down_at, told }
let probing = {};         // exit name -> a probe is running (they never overlap)
let dns_mode = null;      // 'tunnel' | 'fallback'
let events = [];
let switches = 0, last_switch = null, auth_state = 'ok';
let down_noted = {};
let opened = {};          // policies with on_down 'direct' that go directly now (all their exits down): name -> id
let lists_busy = false, subs_busy = false;
let apply_errors = [];    // the last apply's errors and warnings (config + nft + setup), shown in LuCI
let pol_keys = null;      // what put flows under a policy at the last load (dst / device), see load_all
let dom_keys = null;      // the single domains of each policy at the last load: one taken off has its addresses forgotten
let off = false;          // main.enabled = 0 came with a reload: everything is taken down, the daemon idles until procd stops it
let extip = { direct: null, exits: {} };   // the outside address seen directly and through each exit: { ip, loc, colo, ts } (Overview)

function ev(msg) {
	push(events, sprintf('%d %s', time(), msg));
	if (length(events) > 50) shift(events);
	core.log(msg);
	core.vlog('event', msg);
}

// ---- the level of the log: main.log_level 'verbose' holds main.log_until (24 h); the flag file is what every writer
// looks at. Past the time: back to normal (UCI written with libuci: no procd reload trigger, no loop).
const LOG_HOURS = 24, LOG_MAX = 1048576;
function log_sync() {
	const c = cursor();
	let lvl = c.get('detour', 'main', 'log_level') ?? 'normal';
	const until = int(c.get('detour', 'main', 'log_until') ?? 0);
	if (lvl == 'verbose' && (!until || time() >= until)) {
		c.delete('detour', 'main', 'log_level'); c.delete('detour', 'main', 'log_until'); c.commit('detour');
		lvl = 'normal';
		ev(until ? sprintf('verbose log: %d h passed, back to the normal level', LOG_HOURS) : 'verbose log: no end time set, back to the normal level');
	}
	fs.mkdir(core.RUN); fs.mkdir(core.LOGDIR);
	if (lvl == 'verbose') { if (!fs.access(core.VFLAG)) fs.writefile(core.VFLAG, sprintf('%d
', until)); }
	else fs.unlink(core.VFLAG);
	// one writer rotates: the others only append
	const st = fs.stat(core.VLOG);
	if (st && st.size > LOG_MAX) fs.rename(core.VLOG, core.VLOG + '.1');
	return { level: lvl, until: lvl == 'verbose' ? until : null };
}
function log_state() {
	const st = log_sync();
	const sz = (f) => fs.stat(f)?.size ?? 0;
	st.size = sz(core.VLOG) + sz(core.VLOG + '.1');
	return st;
}
function set_log_level(level) {
	if (level != 'verbose' && level != 'normal') return { error: 'level: normal or verbose' };
	const c = cursor();
	if (level == 'normal') ev('verbose log off');   // the last line of the verbose log
	if (level == 'verbose') { c.set('detour', 'main', 'log_level', 'verbose'); c.set('detour', 'main', 'log_until', '' + (time() + LOG_HOURS * 3600)); }
	else { c.delete('detour', 'main', 'log_level'); c.delete('detour', 'main', 'log_until'); }
	c.commit('detour');
	fs.unlink(core.VFLAG);
	const st = log_state();
	core.verbose(true);
	if (level == 'verbose') ev(sprintf('verbose log on for %d h', LOG_HOURS));
	return st;
}

function exit_name(id) { return core.exit_by_id(cfg, id)?.name ?? ('exit' + id); }

// notifications: the names people gave, in quotes
function xl(id) { const e = core.exit_by_id(cfg, id); return watch.q(e?.label ?? e?.name ?? ('exit' + id)); }
function pl(p) { return watch.q(p.label ?? p.name); }
// while the provider's internet is gone (and a little after) the exits' own ups and downs are noise
// -> true when the message was queued
function tell(ev, key, text) {
	if (watch.quiet() && index([ 'exit_down', 'exit_up', 'all_down', 'switch' ], ev) >= 0) return false;
	return !!notify.event(ev, key, text);
}

function healthy(e) {
	if (!e.enabled) return false;
	const h = health[e.name];
	if (!net.dev_up(e.device)) return false;
	if (!e.probe) return true;               // no probe configured: device state only
	return h != null && h.ok && h.fails < cfg.main.fails;
}

function choose(p) {
	const pinned = pins[p.name];
	if (pinned && index(p.exits, pinned) >= 0 && healthy(cfg.by_name[pinned])) return cfg.by_name[pinned].id;
	for (let n in p.exits) if (healthy(cfg.by_name[n])) return cfg.by_name[n].id;
	return null;   // nothing alive: keep the current exit (its table is unreachable -> fail-closed)
}

function ready() {
	// start-up grace: decide only after every probed exit reported once (no flapping at boot)
	for (let e in cfg.exits) if (e.enabled && e.probe && !health[e.name]?.seen) return false;
	return true;
}

function update_dns() {
	if (cfg.main.dns != 'tunnel') { dns_mode = null; return; }
	let alive = false;
	for (let p in cfg.policies)
		if (p.name == cfg.main.dns_policy)
			for (let n in p.exits) if (healthy(cfg.by_name[n])) alive = true;
	const mode = alive ? 'tunnel' : 'fallback';
	if (mode == dns_mode) return;
	if (dns.write_servers(cfg, mode)) dns.hup();
	if (dns_mode != null || mode == 'fallback') ev('router DNS: ' + mode);
	dns_mode = mode;
}

function evaluate() {
	if (off || !ready()) return;
	let changed = false;
	for (let p in cfg.policies) {
		if (!p.enabled || p.block || p.direct) continue;   // "Block" and "Directly" have no exits to choose
		const want = choose(p);
		const cur = active['' + p.id];
		if (want == null) {
			// told only when it lasts (main.alert_hold): a blip of a second or two is not an outage
			const d = (down_noted[p.name] ??= { t: time(), told: false });
			const lasting = time() - d.t >= cfg.main.alert_hold;
			// on_down 'direct': the owner chose to let this policy's traffic go directly while every exit is down
			// (after the same hold, so a blip does not open it); flows pinned to the dead exit are reset
			const open = p.on_down == 'direct' && length(p.exits);
			if (open && lasting && !opened[p.name]) {
				const r = nft.set_policy_direct(p.id);
				if (r.code == 0) {
					if (cur) net.flush_conntrack_policy(p.id, cur);
					opened[p.name] = p.id;
					ev(sprintf('policy %s: no working exit - goes directly', p.name));
				}
				else ev(sprintf('policy %s: switch failed: %s', p.name, trim(r.out)));
			}
			if (!d.told && lasting)
				d.told = tell('all_down', 'all_down:' + p.name, sprintf(open ? _('Policy %s: no exit works, its traffic goes directly (as set up)')
					: (length(p.exits) ? _('Policy %s: no exit works, its traffic is blocked')
					: _('Policy %s has no exits left, its traffic is blocked')), pl(p)));
			continue;
		}
		if (down_noted[p.name]) {
			if (down_noted[p.name].told)
				tell('all_down', null, sprintf(opened[p.name] ? _('Policy %s goes through the exits again (it went directly for %s)') : _('Policy %s works again (it was blocked for %s)'),
					pl(p), watch.dur(time() - down_noted[p.name].t)));
			delete down_noted[p.name];
		}
		// back from "directly": the exit is set again even when it is the same one
		if (want == cur && !opened[p.name]) continue;
		const was_open = !!opened[p.name];
		if (was_open) { delete opened[p.name]; ev(sprintf('policy %s: an exit works again - through it', p.name)); }
		const r = nft.set_policy_exit(p.id, want);
		if (r.code != 0) { ev(sprintf('policy %s: switch failed: %s', p.name, trim(r.out))); continue; }
		// the flows it opened directly (podirect: the policy mark, no exit) go through the exit from now on
		if (was_open) net.flush_conntrack_policy(p.id, 0);
		// flows of this policy pinned to the old exit are dropped, the next packet re-classifies
		if (cur) net.flush_conntrack_policy(p.id, cur);
		active['' + p.id] = want;
		changed = true;
		switches++; last_switch = time();
		ev(sprintf('policy %s: %s -> %s%s', p.name, cur ? exit_name(cur) : '-', exit_name(want), pins[p.name] ? ' (pinned ' + pins[p.name] + ')' : ''));
		if (cur) tell('switch', 'switch:' + p.name, sprintf(_('Policy %s switched: %s → %s'), pl(p), xl(cur), xl(want)));
	}
	if (changed) fw.save_active(active);
	update_dns();
}

function probe(e) {
	const cmd = net.probe_cmd(e, cfg.main.probe_timeout);
	// one probe of an exit at a time: a slow answer must not be counted twice by the probes started after it
	if (!cmd || !e.enabled || probing[e.name]) return;
	probing[e.name] = true;
	const t_start = clock(true);
	const proc = uloop.process(cmd[0], slice(cmd, 1), {}, function(code) {
		delete probing[e.name];
		if (core.verbose()) {
			const t = clock(true);
			core.vlog('probe', sprintf('%s via %s: %s -> %s (%d ms)', e.name, e.device, e.probe, code == 0 ? 'ok' : 'failed, code ' + code,
				(t[0] - t_start[0]) * 1000 + int((t[1] - t_start[1]) / 1000000)));
		}
		const h = health[e.name] ??= { ok: false, fails: 0, seen: false };
		const was = h.ok && h.fails < cfg.main.fails;
		h.seen = true;
		if (code == 0) { h.ok = true; h.fails = 0; h.last_ok = time(); }
		else { h.fails++; if (h.fails >= cfg.main.fails) h.ok = false; }
		const now = h.ok && h.fails < cfg.main.fails;
		if (was != now) {
			ev(sprintf('exit %s %s', e.name, now ? 'up' : 'down'));
			// the message about "down" waits main.alert_hold seconds (alerts()); "up" is said only after it
			if (!now) { h.down_at = time(); h.told = false; }
			else {
				if (h.told) tell('exit_up', null, sprintf(_('Exit %s works again (it did not answer for %s)'), watch.q(e.label ?? e.name), watch.dur(time() - h.down_at)));
				h.down_at = null; h.told = false;
			}
		}
		evaluate();
	});
	if (!proc) delete probing[e.name];
}

function guard() {
	try { return auth.guard(); }
	catch (e) { ev('2FA guard error: ' + e); return 'error'; }
}

// domains taken off a policy: forgotten in the background (detour dom-forget: its lists may still cover them; an
// nslookup per name and nft/conntrack per address must not hold the daemon and the reload's answer)
let forget_seq = 0;
function forget_domains(gone) {
	const f = sprintf('%s/forget-%d-%d', core.RUN, time(), ++forget_seq);
	fs.writefile(f, join('\n', gone) + '\n');
	uloop.process('/bin/sh', [ '-c', sprintf('/usr/sbin/detour dom-forget %s > %s.out 2>/dev/null', core.shq(f), core.shq(f)) ], {}, function() {
		let r = null;
		try { r = json(fs.readfile(f + '.out') ?? 'null'); } catch (e) { }
		fs.unlink(f); fs.unlink(f + '.out');
		if (type(r) != 'object') return ev(sprintf('domains taken off a policy: %d, forgetting their addresses failed', length(gone)));
		ev(sprintf('domains taken off a policy: %d%s, their addresses forgotten (%d)', length(gone),
			r.kept ? sprintf(' (%d still in its lists, kept)', r.kept) : '', r.addrs));
	});
}

function load_all(reason) {
	log_sync();
	cfg = core.load();
	off = !cfg.main.enabled;
	if (off) {
		// switched off in the settings: the table, the rules and the DNS management go (fw.start does it)
		const r = fw.start();
		active ??= {}; pins ??= {};
		apply_errors = [];
		ev(reason + ': Detour is switched off, everything goes directly');
		return r;
	}
	// what is known about exits that are gone must not pass to new ones
	for (let n in keys(health)) if (!cfg.by_name[n]) delete health[n];
	pins = fw.pins();
	for (let p in keys(pins))
		if (!length(filter(cfg.policies, (x) => x.name == p))) delete pins[p];
	const res = fw.apply(cfg, active ? fw.active_map(cfg) : null);
	active = fw.active_map(cfg);
	// the rules were rendered with every policy on an exit: one that went directly is opened again by evaluate();
	// its direct flows would stay direct (pinned by podirect), so they are dropped
	for (let n, id in opened) net.flush_conntrack_policy(id, 0);
	opened = {};
	// destinations / devices newly under a policy: their direct flows (offloaded ones would never be
	// re-classified) are dropped so the next packets meet the new rules
	const keys = {}, nd = [], nm = [], np = [], ns = [], nn = [];
	for (let p in cfg.policies) {
		if (!p.enabled || p.direct) continue;   // under "Directly" the flows already go direct
		for (let d in p.dst4) keys['d ' + d] = true;
		for (let m in p.devices) keys['m ' + m] = true;
		for (let a in p.src4) keys['s ' + a] = true;
		for (let i in p.ifdevs ?? []) keys['n ' + i] = true;   // whole networks (their devices, by fw.apply)
		for (let pr in [ 'tcp', 'udp' ]) for (let x in p.ports?.[pr] ?? []) keys['p ' + pr + '/' + x] = true;
	}
	if (pol_keys != null)
		for (let k in keys) if (!pol_keys[k]) push({ d: nd, m: nm, p: np, s: ns, n: nn }[substr(k, 0, 1)], substr(k, 2));
	pol_keys = keys;
	// a network: the flows from its subnets
	const nsrc = [ ...ns ];
	for (let i in nn) for (let s in net.dev_nets4(i)) push(nsrc, s);
	if (length(nd) || length(nm) || length(np) || length(ns) || length(nn)) ev(sprintf('new under a policy: %d destinations, %d devices, %d ports, %d sources, %d networks - their direct flows reset (%d)',
		length(nd), length(nm), length(np), length(ns), length(nn), net.flush_unclassified(nd, nm, np, nsrc)));
	if (res.dns_restart) dns.restart();
	// domains taken off a policy (removed, moved, the policy switched off): their addresses leave its sets now, not
	// after the set's timeout - unless a parent domain still keeps them there
	const dk = dns.dom_keys(cfg), gone = [];
	for (let k in dom_keys ?? {}) {
		if (dk[k]) continue;
		const sp = index(k, ' '), pid = substr(k, 0, sp), parts = split(substr(k, sp + 1), '.');
		let kept = false;
		// a parent still in the policy keeps them - up to the top level ("ru" keeps "example.ru")
		for (let i = 1; i < length(parts); i++) if (dk[pid + ' ' + join('.', slice(parts, i))]) kept = true;
		if (!kept) push(gone, k);
	}
	dom_keys = dk;
	if (length(gone)) forget_domains(gone);
	apply_errors = res.errors;
	// engines the init script could not start (it only tells its stderr): here they reach the log and LuCI
	for (let e in engines.list()) {
		if (!e.enabled) continue;
		if (!e.installed) push(apply_errors, sprintf('engine %s: %s is not installed', e.name, e.type == 'xray' ? 'xray-core' : 'sing-box'));
		else if (!fs.access('/dev/net/tun')) push(apply_errors, sprintf('engine %s: no /dev/net/tun (apk add kmod-tun)', e.name));
	}
	for (let e in apply_errors) ev('config: ' + e);
	dns_mode = null;
	ev(sprintf('%s: %d exits, %d policies', reason, length(cfg.exits), length(cfg.policies)));
	// lists: rebuild the sets for the current policies, download lists that have no data yet
	// subscriptions that have no exit yet (new, imported): first download now, not at night
	if (!subs_busy) {
		const todo = [];
		cursor().foreach('detour', 'subscription', (s) => {
			if (s.enabled != '0' && cursor().get('detour', s['.name'] + '_sub') != 'exit') push(todo, s['.name']);
		});
		if (length(todo)) {
			subs_busy = true;
			uloop.process('/bin/sh', [ '-c', join('; ', map(todo, (n) => '/usr/sbin/detour sub-update ' + core.shq(n) + ' >/dev/null 2>&1')) ], {},
				function() { subs_busy = false; });
		}
	}
	if (fw.has_lists() && !lists_busy) {
		lists_busy = true;
		uloop.process('/usr/libexec/detour/lists-update', [ '--missing' ], {}, function(code) { lists_busy = false; });
	}
	return res;
}

function lists_status(dir) {
	const out = [];
	for (let f in fs.glob(core.RUN + '/' + (dir ?? 'lists') + '/*.status') ?? []) {
		try { push(out, json(fs.readfile(f))); } catch (e) { }
	}
	return out;
}

function status() {
	const ex = [];
	for (let e in cfg.exits) {
		const h = health[e.name] ?? {};
		push(ex, { name: e.name, id: e.id, device: e.device, enabled: e.enabled, up: net.dev_up(e.device),
			healthy: healthy(e), probe: e.probe, fails: h.fails ?? 0, last_ok: h.last_ok, drops: nft.counter_drops(e.id),
			colo: trim(fs.readfile(sprintf('%s/warp-%s.colo', core.RUN, e.name)) ?? '') || null,
			rx: int(fs.readfile(sprintf('/sys/class/net/%s/statistics/rx_bytes', e.device)) ?? 0),
			tx: int(fs.readfile(sprintf('/sys/class/net/%s/statistics/tx_bytes', e.device)) ?? 0) });
	}
	const pol = [];
	for (let p in cfg.policies)
		push(pol, { name: p.name, id: p.id, enabled: p.enabled, exits: p.exits,
			active: active['' + p.id] ? exit_name(active['' + p.id]) : null, pinned: pins[p.name],
			block: p.block, action: p.block ? 'block' : (p.direct ? 'direct' : 'vpn'), on_down: p.on_down, direct: !!opened[p.name] });
	return { version: core.VERSION, uptime: time() - t0, exits: ex, policies: pol, blocked: nft.counter_blocked(), dns: dns_mode ?? cfg.main.dns,
		dnsproxy: !!core.dnsproxy_bin(), socks: socks.info(cfg),
		switches, last_switch, engines: engines.list(), lists: lists_status(), lists_memory: listmem.budget(), subscriptions: lists_status('subs'), auth: auth.status(), notify_queued: notify.queued(), wan: watch.wan_down() ? 'down' : 'up', notify_quiet: watch.quiet(), errors: apply_errors, events, extip, log: log_state() };
}

function do_pin(pol, ex) {
	let p = null;
	for (let x in cfg.policies) if (x.name == pol) p = x;
	if (!p) return { error: 'unknown policy' };
	if (ex == null || ex == '') delete pins[pol];
	else {
		if (index(p.exits, ex) < 0) return { error: 'exit is not in this policy' };
		pins[pol] = ex;
	}
	fw.save_pins(pins);
	ev(sprintf('policy %s: %s', pol, pins[pol] ? 'pinned to ' + pins[pol] : 'unpinned'));
	evaluate();
	return { policy: pol, pinned: pins[pol], active: active['' + p.id] ? exit_name(active['' + p.id]) : null };
}

uloop.init();
const conn = ubus.connect();
if (!conn) { warn('detourd: no ubus\n'); exit(1); }
fs.mkdir(core.RUN);
watch.init();
load_all('start');

// --- LuCI actions ------------------------------------------------------------------------------
// backup: the daemon's job writes it here, LuCI downloads it (ACL: read, write = remove); a restore: LuCI uploads here
const BACKUP_OUT = '/tmp/detour-backup.bin';
const RESTORE_IN = '/tmp/detour-restore.bin';
let job_busy = false;

function cli_job(req, argv, reload_after) {
	// refused: the files secret_arg wrote (a link, a config with keys) are removed here, the CLI never reads them
	const refuse = (msg) => {
		for (let a in argv) if (type(a) == 'string' && index(a, '@' + core.RUN + '/in-') == 0) fs.unlink(substr(a, 1));
		return { error: msg };
	};
	if (job_busy) return refuse('another action is running, try again in a moment');
	for (let a in argv) if (type(a) != 'string' || !length(a)) return refuse('missing argument');
	job_busy = true;
	req.defer();
	const out = core.RUN + '/job.out';
	const cmd = '/usr/sbin/detour ' + join(' ', map(argv, (a) => core.shq(a))) + ' > ' + out + ' 2>&1';
	uloop.process('/bin/sh', [ '-c', cmd ], {}, function(code) {
		job_busy = false;
		const text = fs.readfile(out) ?? '';
		let res;
		try { res = json(text); } catch (e) { res = { output: trim(text) }; }
		if (type(res) != 'object') res = { output: trim(text) };
		res.code = code;
		if (code != 0 && !res.error) res.error = trim(text) || ('exit code ' + code);
		ev(sprintf('LuCI: %s -> %s', argv[0], code == 0 ? 'ok' : 'error'));
		if (reload_after && code == 0) {
			if (argv[0] == 'restore') traffic.reset();   // the history on flash was merged with the backup's
			load_all(argv[0]); evaluate();
		}
		req.reply(res);
	});
}

// lab only: main.warp_api / warp_peer / warp_port point the registration at a stub
function warp_args(name) {
	const m = cursor().get_all('detour', 'main') ?? {};
	const a = [ 'warp-register', name ];
	if (m.warp_api) push(a, 'api=' + m.warp_api);
	if (m.warp_peer) push(a, 'peer=' + m.warp_peer);
	if (m.warp_port) push(a, 'port=' + m.warp_port);
	return a;
}

// LuCI "Exits": what each exit is (exitui) with its live state from the probes
function exits_info() {
	const st = {};
	for (let x in status().exits) st[x.name] = x;
	return { exits: map(exitui.info(), function(x) {
		const h = st[x.name] ?? {};
		x.healthy = h.healthy; x.up = h.up; x.last_ok = h.last_ok; x.colo = h.colo; x.drops = h.drops; x.id = h.id;
		return x;
	}) };
}

// "Check": a real request through the exit's device - time, the address and country it leaves from
let check_busy = {};
function exit_check(req) {
	const e = filter(cfg.exits, (x) => x.name == req.args.name)[0];
	if (!e) return { error: 'no exit ' + (req.args.name ?? '') };
	if (check_busy[e.name]) return { error: 'a check of this exit is running' };
	check_busy[e.name] = true;
	req.defer();
	const f = sprintf('%s/check-%s', core.RUN, e.name);
	const cmd = sprintf("curl -s -m 12 --interface %s -o %s.body -w '%%{http_code} %%{time_total}' https://1.1.1.1/cdn-cgi/trace > %s.code 2>/dev/null",
		core.shq(e.device), f, f);
	uloop.process('/bin/sh', [ '-c', cmd ], {}, function(code) {
		delete check_busy[e.name];
		const w = split(trim(fs.readfile(f + '.code') ?? ''), ' ');
		const body = fs.readfile(f + '.body') ?? '';
		fs.unlink(f + '.code'); fs.unlink(f + '.body');
		const kv = {};
		for (let l in split(body, '\n')) { const m = match(l, /^([a-z]+)=(.*)$/); if (m) kv[m[1]] = m[2]; }
		const ok = w[0] == '200' && kv.ip;
		if (ok) extip.exits[e.name] = { ip: kv.ip, loc: kv.loc, colo: kv.colo, ts: time() };
		req.reply(ok ? { ok: true, ms: int((w[1] ?? 0) * 1000), ip: kv.ip, loc: kv.loc, colo: kv.colo, warp: kv.warp }
			: { ok: false, http: w[0] ?? '000', error: (w[0] == '000' || !length(w[0] ?? '')) ? 'no answer through the exit' : 'unexpected answer ' + w[0] });
	});
}

// a subscription's group (engines.api_conf): which server the automatic choice uses and the delays measured;
// "check" one server without switching. sing-box: its clash API; Xray: "xray api bi" for the balancer's choice (no
// delays) and its check inbound (user sN = server N). Deferred: to 127.0.0.1, short timeouts.
let api_seq = 0;
function sub_group(req) {
	if (!match(req.args.name ?? '', /^[a-z][a-z0-9_]*$/)) return null;
	return engines.api_info(req.args.name + '_eng');
}
function sub_run(req, cmd, done) {
	req.defer();
	uloop.process('/bin/sh', [ '-c', cmd ], {}, function() { req.reply(done()); });
}
function sub_api(req, a, path, timeout, done) {
	const f = sprintf('%s/api-%s-%d', core.RUN, req.args.name, ++api_seq);   // answers of parallel checks never share a file
	const cmd = sprintf("curl -s -m %d -K %s -o %s.body -w '%%{http_code}' 'http://127.0.0.1:%d%s' > %s.code 2>/dev/null",
		timeout, core.shq(engines.api_file(req.args.name + '_eng')), f, a.port, path, f);
	sub_run(req, cmd, function() {
		const http = trim(fs.readfile(f + '.code') ?? '');
		let body = null;
		try { body = json(fs.readfile(f + '.body') ?? 'null'); } catch (e) { }
		fs.unlink(f + '.code'); fs.unlink(f + '.body');
		return done(http, body);
	});
}

function sub_state(req) {
	const a = sub_group(req);
	if (!a) return { error: 'no automatic server group for ' + (req.args.name ?? '') };
	if (a.engine == 'xray') {
		const f = sprintf('%s/api-%s-%d', core.RUN, req.args.name, ++api_seq);
		return sub_run(req, sprintf("xray api bi --server=127.0.0.1:%d -t 3 -json out > %s 2>/dev/null", a.port, f), function() {
			let b = null;
			try { b = json(fs.readfile(f) ?? 'null'); } catch (e) { }
			fs.unlink(f);
			const t = b?.balancer?.override?.target ?? b?.balancer?.principleTarget?.tag?.[0];
			if (!b?.balancer) return { error: 'the engine does not answer' };
			const m = match(t ?? '', /^s([0-9]+)$/);
			return { now: m ? int(m[1]) - 1 : null, delays: {} };
		});
	}
	return sub_api(req, a, '/proxies', 4, function(http, b) {
		if (http != '200' || type(b?.proxies) != 'object') return { error: 'the engine does not answer' };
		const out = { now: null, delays: {} };
		const m = match(b.proxies.out?.now ?? '', /^s([0-9]+)$/);
		if (m) out.now = int(m[1]) - 1;
		for (let tag, p in b.proxies) {
			const t = match(tag, /^s([0-9]+)$/);
			if (!t) continue;
			const h = p.history ?? [];
			out.delays['' + (int(t[1]) - 1)] = length(h) ? h[length(h) - 1].delay : null;
		}
		return out;
	});
}

function sub_check(req) {
	const i = int(req.args.index ?? -1);
	if (i < 0 || i > 999) return { error: 'bad server index' };
	const a = sub_group(req);
	if (!a) return { error: 'no automatic server group for ' + (req.args.name ?? '') };
	const url = cursor().get('detour', 'main', 'urltest_url') ?? 'https://www.gstatic.com/generate_204';
	if (a.engine == 'xray') {
		if (!a.socks) return { error: 'no automatic server group for ' + req.args.name };
		// a request through the check inbound as user sN: that server only; the password in a file, not argv
		const f = sprintf('%s/api-%s-%d', core.RUN, req.args.name, ++api_seq);
		fs.writefile(f + '.k', ''); fs.chmod(f + '.k', 0600);
		fs.writefile(f + '.k', sprintf('proxy = "socks5h://127.0.0.1:%d"\nproxy-user = "s%d:%s"\nurl = "%s"\n', a.socks, i + 1, a.secret, replace(url, '"', '%22')));
		return sub_run(req, sprintf("curl -s -m 8 -K %s -o /dev/null -w '%%{http_code} %%{time_total}' > %s.code 2>/dev/null", f + '.k', f), function() {
			const w = split(trim(fs.readfile(f + '.code') ?? ''), ' ');
			fs.unlink(f + '.k'); fs.unlink(f + '.code');
			if (match(w[0] ?? '', /^(200|204)$/)) return { ok: true, ms: int(+(w[1] ?? 0) * 1000) };
			return { ok: false, error: 'no answer through this server' };
		});
	}
	return sub_api(req, a, sprintf('/proxies/s%d/delay?timeout=6000&url=%s', i + 1, replace(url, /[^A-Za-z0-9._~:\/-]/g, (c) => sprintf('%%%02X', ord(c)))), 9,
		function(http, b) {
			if (http == '200' && b?.delay != null) return { ok: true, ms: b.delay };
			return { ok: false, error: (http == '504' || http == '408' || http == '503') ? 'no answer through this server' : (b?.message ?? 'no answer') };
		});
}

// text with keys or passwords for the CLI: a file of mode 600 the CLI removes, never the command line
let in_seq = 0;
function secret_arg(text) {
	const f = sprintf('%s/in-%d-%d', core.RUN, time(), ++in_seq);
	fs.writefile(f, ''); fs.chmod(f, 0600);
	fs.writefile(f, text ?? '');
	return '@' + f;
}

function backup_job(req, argv, reload_after) {
	const pw = req.args.password ?? '';
	if (type(pw) != 'string' || length(pw) < 8) return { error: 'the password must be at least 8 characters' };
	if (job_busy) return { error: 'another action is running, try again in a moment' };
	const a = argv();
	splice(a, 2, 0, secret_arg(pw));
	return cli_job(req, a, reload_after);
}

// curl as the system user dtnotify: Detour never classifies its traffic, so "directly" really is direct even when
// the address is on a list that goes through a tunnel
function direct_curl() {
	return match(fs.readfile('/etc/passwd') ?? '', /(^|\n)dtnotify:/)
		? 'start-stop-daemon -S -p ' + core.RUN + '/none.pid -c dtnotify -x /usr/bin/curl --' : 'curl';
}

// the provider's line: the device of the main table's default route
function wan_dev() {
	const m = match(core.run('ip -4 route show default table main').out, /dev ([^ \n]+)/);
	return m ? m[1] : null;
}

// what curl's -w line in f says about a speed test (url: where it downloaded from, its host told); f is removed
function speed_result(f, url) {
	const host = match(url ?? '', /^[a-z]+:\/\/([^\/:?#]+)/)?.[1];
	const w = split(trim(fs.readfile(f) ?? ''), ' ');
	fs.unlink(f);
	const bytes = +(w[2] ?? 0);
	// a download cut at 14 s still tells the speed; too little data says nothing
	if (bytes < 500000) return { ok: false, error: 'too little came through (' + int(bytes / 1024) + ' KB)', host };
	return { ok: true, mbps: int(+w[1] * 8 / 100000) / 10, mb: int(bytes / 104857.6) / 10, s: int(+w[3] * 10) / 10, host };
}

// "Speed": a download of up to 25 MB through the exit (or directly, to compare), at most 14 s
let speed_busy = false;
function exit_speed(req) {
	if (speed_busy) return { error: 'a speed test is running' };
	let dev;
	if (req.args.direct) dev = wan_dev();
	else dev = filter(cfg.exits, (x) => x.name == req.args.name)[0]?.device;
	if (!dev) return { error: req.args.direct ? 'no provider line' : 'no exit ' + (req.args.name ?? '') };
	speed_busy = true;
	req.defer();
	const f = core.RUN + '/speed';
	const url = cursor().get('detour', 'main', 'speed_url') ?? 'https://speed.cloudflare.com/__down?bytes=25000000';
	uloop.process('/bin/sh', [ '-c', sprintf("%s -s -m 14 --interface %s -o /dev/null -w '%%{http_code} %%{speed_download} %%{size_download} %%{time_total}' %s > %s 2>/dev/null",
		req.args.direct ? direct_curl() : 'curl', core.shq(dev), core.shq(url), f) ], {}, function() {
		speed_busy = false;
		req.reply(speed_result(f, url));
	});
}

// "Speed" of one server of a subscription: the same download through its group's check inbound as user sN
// (that server only, the group does not switch); the password in a file, not on the command line
function sub_speed(req) {
	const i = int(req.args.index ?? -1);
	if (i < 0 || i > 999) return { error: 'bad server index' };
	const a = sub_group(req);
	if (!a || !a.socks) return { error: 'no automatic server group for ' + (req.args.name ?? '') };
	if (speed_busy) return { error: 'a speed test is running' };
	speed_busy = true;
	req.defer();
	const f = sprintf('%s/speed-%s', core.RUN, req.args.name);
	const url = cursor().get('detour', 'main', 'speed_url') ?? 'https://speed.cloudflare.com/__down?bytes=25000000';
	fs.writefile(f + '.k', ''); fs.chmod(f + '.k', 0600);
	fs.writefile(f + '.k', sprintf('proxy = "socks5h://127.0.0.1:%d"\nproxy-user = "s%d:%s"\nurl = "%s"\n', a.socks, i + 1, a.secret, replace(url, '"', '%22')));
	uloop.process('/bin/sh', [ '-c', sprintf("curl -s -m 14 -K %s -o /dev/null -w '%%{http_code} %%{speed_download} %%{size_download} %%{time_total}' > %s 2>/dev/null",
		core.shq(f + '.k'), f) ], {}, function() {
		speed_busy = false;
		fs.unlink(f + '.k');
		req.reply(speed_result(f, url));
	});
}

// Why an exit does not work, as far as the router can tell: does its server's address answer directly (or
// through the exit it rides) and through another working exit. Silent directly, answering elsewhere = the
// provider blocks the address.
// Through the provider's line or a kernel tunnel (WireGuard / AmneziaWG) a TCP connection is enough
// (time_connect > 0, the protocol does not matter). A proxy exit's tun (sing-box, Xray) accepts every TCP
// connection on the router itself, before the far end answers: through one only a real TLS answer counts
// (time_appconnect > 0) - fine for TLS / Reality servers, while a plain-TCP server (Shadowsocks) stays unknown.
// So another exit for the comparison is a kernel tunnel when there is one. UDP servers (WireGuard, Hysteria,
// TUIC) give no such answer at all.
function diag_exit(name, cb) {
	const info = exitui.info();
	const x = filter(info, (i) => i.name == name)[0];
	if (!x?.server || !x?.port) return cb({ verdict: 'unknown' });
	if (index([ 'wireguard', 'amneziawg' ], x.kind) >= 0 || match(x.proto ?? '', /^(Hysteria|TUIC|WireGuard)/))
		return cb({ verdict: 'udp', server: x.server, port: x.port });
	// a proxy exit without its device: the engine did not start - nothing about the server can be told from here
	const me = cfg.by_name[name];
	if (x.engine && me && !fs.access('/sys/class/net/' + me.device))
		return cb({ verdict: fs.access('/dev/net/tun') ? 'nodev' : 'notun', server: x.server, port: x.port, engine: true });
	const proxy = {};
	for (let i in info) proxy[i.name] = !!i.engine;
	const via = x.via ? cfg.by_name[x.via] : null;
	const first = via ? via.device : wan_dev();
	// another working exit: not this one, not the one it rides, not one that rides this one; a kernel tunnel first
	let other = null;
	for (let e in cfg.exits) {
		if (e.name == name || e.name == x.via || !healthy(e)) continue;
		if (cursor().get('detour', e.name + '_eng', 'via') == name) continue;
		if (!other || (proxy[other.name] && !proxy[e.name])) other = e;
	}
	const host = index(x.server, ':') >= 0 ? '[' + x.server + ']' : x.server;
	// both checks at once, at most 5 s: the "exit down" message waits for this answer
	const f = sprintf('%s/diag-%s', core.RUN, name);
	const t = (dev, bin, tls, out) => sprintf("( %s -s -k -o /dev/null --connect-timeout 4 -m 5 --interface %s -w '%s' %s 2>/dev/null; echo \" $?\" ) > %s",
		bin ?? 'curl', core.shq(dev), tls ? '%{time_appconnect}' : '%{time_connect}', core.shq(sprintf('%s://%s:%d/', tls ? 'https' : 'http', host, x.port)), out);
	uloop.process('/bin/sh', [ '-c', t(first, via ? null : direct_curl(), via && proxy[via.name], f + '.a') + ' & ' +
		(other ? t(other.device, null, proxy[other.name], f + '.b') + ' & ' : '') + 'wait' ], {}, function() {
		const lines = [ trim(fs.readfile(f + '.a') ?? ''), trim(fs.readfile(f + '.b') ?? '') ];
		fs.unlink(f + '.a'); fs.unlink(f + '.b');
		const up = (l) => { const m = match(l ?? '', /^([0-9.]+) ([0-9]+)$/); return m ? { ok: +m[1] > 0, code: int(m[2]) } : { ok: false, code: -1 }; };
		const a = up(lines[0]), b = other ? up(lines[1]) : null;
		let verdict;
		if (a.code == 6) verdict = 'dns';
		else if (a.ok) verdict = 'reachable';
		else if (b?.ok) verdict = 'blocked';
		else verdict = b ? 'down' : 'silent';
		cb({ verdict, server: x.server, port: x.port, via: x.via, other: other?.name, other_label: other?.label,
			engine: !!x.engine });
	});
}

// the catalogue of list categories: the v2fly names as listed upstream (lists-update keeps them on flash; LuCI
// uses its built-in catalogue when there are none yet)
const V2NAMES = core.PERSIST + '/v2fly-names.txt';
function catalog_names() {
	const t = fs.readfile(V2NAMES);
	if (!t) return { v2fly: null };
	const out = [];
	let date = null;
	for (let l in split(t, '\n')) {
		if (substr(l, 0, 2) == '# ') { date = trim(substr(l, 2)); continue; }
		if (match(l, /^[a-z0-9._!-]+$/)) push(out, l);
	}
	return { v2fly: out, date, checked: fs.stat(V2NAMES)?.mtime };
}
let cat_busy = false;
function catalog_refresh(req) {
	if (cat_busy) return { error: 'already running' };
	cat_busy = true;
	req.defer();
	uloop.process('/usr/libexec/detour/lists-update', [ '--catalog' ], {}, function(code) {
		cat_busy = false;
		const r = catalog_names();
		r.ok = code == 0;
		if (code != 0) r.error = 'the list of categories did not come';
		req.reply(r);
	});
}

// "Check a site": where it goes (rules) and does it open directly and through an exit
// It asks dnsmasq and nft a lot (the DNS log asks it for up to 150 names): run in a child process, two at a time,
// the rest wait in a queue, so the probes never stop meanwhile.
let explain_q = [], explain_run = 0, explain_seq = 0;
function explain_next() {
	while (explain_run < 2 && length(explain_q)) {
		const j = shift(explain_q);
		explain_run++;
		const f = sprintf('%s/explain-%d', core.RUN, ++explain_seq);
		fs.writefile(f + '.json', sprintf('%J', j.st));
		const cmd = sprintf('/usr/libexec/detour/site-explain %s %s %s > %s 2>/dev/null', core.shq(f + '.json'),
			core.shq(j.target), core.shq(j.mac), core.shq(f + '.out'));
		uloop.process('/bin/sh', [ '-c', cmd ], {}, function(code) {
			explain_run--;
			let r = null;
			try { r = json(fs.readfile(f + '.out') ?? 'null'); } catch (e) { }
			fs.unlink(f + '.out'); fs.unlink(f + '.json');
			j.req.reply((type(r) == 'object') ? r : { error: 'the check failed' });
			explain_next();
		});
	}
}
function site_explain(req) {
	const t = sitecheck.target(req.args.target);
	if (t.error) return t;
	if (length(explain_q) >= 200) return { error: 'too many checks at once, try again in a moment' };
	const st = { active: {}, direct: opened };
	for (let p in cfg.policies) {
		const id = active['' + p.id];
		if (id) { const e = core.exit_by_id(cfg, id); st.active[p.name] = { name: e?.name, label: e?.label ?? e?.name }; }
	}
	req.defer();
	push(explain_q, { req, st, target: req.args.target, mac: req.args.mac ?? '' });
	explain_next();
}

let site_busy = false;
function site_check(req) {
	const t = sitecheck.target(req.args.target);
	if (t.error) return t;
	if (site_busy) return { error: 'a check is running' };
	const wan = wan_dev();
	if (!wan) return { error: 'no provider line' };
	// through the chosen exit, else the first one that works
	let e = length(req.args.exit ?? '') ? cfg.by_name[req.args.exit] : null;
	if (!e) for (let x in cfg.exits) if (!e && healthy(x)) e = x;
	site_busy = true;
	req.defer();
	const fd = core.RUN + '/site-d', fv = core.RUN + '/site-v';
	// both paths at once (each "( curl ...; echo $? )" in the background), then wait for both
	const cmd = '( ' + sitecheck.probe_cmd(t.url, wan, direct_curl(), fd) + ' ) & ' +
		(e ? '( ' + sitecheck.probe_cmd(t.url, e.device, null, fv) + ' ) & ' : '') + 'wait';
	uloop.process('/bin/sh', [ '-c', cmd ], {}, function() {
		site_busy = false;
		const d = sitecheck.probe_read(fd), v = e ? sitecheck.probe_read(fv) : null;
		req.reply({ url: t.url, host: t.host, direct: d, vpn: v, exit: e?.name, exit_label: e?.label, verdict: sitecheck.verdict(d, v) });
	});
}

// a function: translated in the language set at the time of the message
function verdict_text(v) {
	return {
		blocked: _("the server's address seems blocked by the provider: no answer directly, an answer through another exit"),
		down: _('the server answers neither directly nor through another exit'),
		silent: _('the server does not answer'),
		reachable: _('the server answers, the protocol itself does not work (keys, settings or the provider filtering the content)'),
		dns: _("the server's name is not found in DNS"),
		nodev: _('the engine did not start: its tunnel device is missing'),
		notun: _('the engine cannot make its tunnel: the kernel module kmod-tun is missing'),
	}[v];
}

// exits that stopped answering and stayed so for main.alert_hold seconds: now it is worth a message
// (here, below diag_exit and verdict_text: ucode resolves a name not declared yet as a global - calling it
// from above crashed the daemon the first time an exit stayed down)
function alerts() {
	for (let e in cfg.exits) {
		const h = health[e.name];
		if (!h?.down_at || h.told || time() - h.down_at < cfg.main.alert_hold) continue;
		if (!e.enabled) { h.down_at = null; continue; }
		// the message says why, when the router can tell (diag_exit, a few seconds); nothing to send - no check
		const nc = notify.config();
		if (h.diag || watch.quiet() || !nc.enabled || index(nc.events, 'exit_down') < 0) continue;
		h.diag = true;
		diag_exit(e.name, function(d) {
			h.diag = false;
			if (!h.down_at || h.told) return;   // it came back meanwhile
			const why = verdict_text(d.verdict);
			h.told = tell('exit_down', 'exit_down:' + e.name, sprintf(_('Exit %s stopped answering'), watch.q(e.label ?? e.name)) + (why ? ': ' + why : ''));
		});
	}
}

// --- Overview: the outside address and the speed -------------------------------------------------
// The address directly (as the system user dtnotify, never classified, so it really is the provider's line) every
// 5 min, through the exit each policy uses now every 10 min; one request at a time, Cloudflare's trace page.
let ip_busy = false;
function ip_probe(dev, direct, done) {
	ip_busy = true;
	const f = core.RUN + '/extip';
	// the shell writes the file: curl may run as dtnotify, which cannot write into /tmp/detour
	const c = (h) => sprintf('%s -sf -m 8 --interface %s https://%s/cdn-cgi/trace', direct ? direct_curl() : 'curl', core.shq(dev), h);
	const cmd = sprintf('{ %s || %s; } > %s 2>/dev/null', c('1.1.1.1'), c('1.0.0.1'), f);
	uloop.process('/bin/sh', [ '-c', cmd ], {}, function() {
		ip_busy = false;
		const kv = {};
		for (let l in split(fs.readfile(f) ?? '', '\n')) { const m = match(l, /^([a-z]+)=(.*)$/); if (m) kv[m[1]] = m[2]; }
		fs.unlink(f);
		done(kv.ip ? { ip: kv.ip, loc: kv.loc, colo: kv.colo, ts: time() } : null);
	});
}
function ip_watch() {
	if (off || ip_busy) return;
	const now = time();
	if (!extip.direct || now - extip.direct.ts >= 300) {
		const dev = wan_dev();
		if (dev) {
			ip_probe(dev, true, function(r) { extip.direct = r ?? { ts: time(), error: true }; });
			return;
		}
	}
	for (let p in cfg.policies) {
		const id = active['' + p.id];
		const e = id ? core.exit_by_id(cfg, id) : null;
		if (!p.enabled || p.block || p.direct || !e || !healthy(e)) continue;
		const x = extip.exits[e.name];
		if (x && now - x.ts < 600) continue;
		ip_probe(e.device, false, function(r) { extip.exits[e.name] = r ?? { ts: time(), error: true }; });
		return;
	}
}

// the speed graph: the counters of the exits' devices and of the provider's line, read every few seconds by the page.
// The line is the device under the default route's interface (for PPPoE: its Ethernet port, eth0 / wan) - the
// PPPoE device itself does not see accelerated flows (measured: 21 MB of a 1 GB direct download).
let wan_port = null, wan_port_at = 0;
function wan_line() {
	if (wan_port && time() - wan_port_at < 60) return wan_port;
	const l3 = wan_dev();
	let port = l3;
	const dump = traffic.netifd_dump();   // a short timeout: a busy netifd must not stall the daemon
	for (let i in dump?.interface ?? [])
		if (i.l3_device == l3 && i.device && fs.access('/sys/class/net/' + i.device)) port = i.device;
	// no answer: the PPPoE device for now, netifd is asked again on the next reading
	if (dump) { wan_port = port; wan_port_at = time(); }
	return port;
}
function rates() {
	const rd = (d) => { const r = fs.readfile('/sys/class/net/' + d + '/statistics/rx_bytes'); return r == null ? null : [ +r, +(fs.readfile('/sys/class/net/' + d + '/statistics/tx_bytes') ?? 0) ]; };
	const c = clock(true);
	const out = { t: c[0] * 1000 + int(c[1] / 1000000), exits: {}, wan: null };
	for (let e in cfg.exits) { const b = rd(e.device); if (b) out.exits[e.name] = b; }
	const w = wan_line();
	if (w) { const b = rd(w); if (b) out.wan = { dev: w, rx: b[0], tx: b[1] }; }
	return out;
}

const S = { ubus_rpc_session: '' };
// every call into the verbose log (status and the other read-only polls of the pages too: a page left open
// would fill the log with them, so those are left out)
const QUIET = { status: true, exits_info: true, traffic: true, rates: true, devices: true, dns_log: true, sub_state: true, pkg_job: true, catalog_names: true, dns_providers: true };
// (a function of its own per method: a closure made in the loop would see the loop's last name)
function logged_call(name, call) {
	return function(req) {
		if (!core.verbose()) return call(req);
		const a = {};
		for (let k, v in req.args ?? {}) if (k != 'ubus_rpc_session') a[k] = v;
		const t = clock(true);
		const r = call(req);
		const d = clock(true);
		core.vlog('ubus', sprintf('%s %J -> %s (%d ms)', name, a,
			r == null ? 'deferred' : (type(r) == 'object' && r.error ? 'error: ' + r.error : 'ok'),
			(d[0] - t[0]) * 1000 + int((d[1] - t[1]) / 1000000)));
		return r;
	};
}
function logged(methods) {
	for (let name, m in methods)
		if (!QUIET[name]) m.call = logged_call(name, m.call);
	return methods;
}
conn.publish('detour', logged({
	status: { call: () => status(), args: { ...S } },
	reload: { call: () => { const r = load_all('reload'); evaluate(); auth_state = guard(); return { ok: r.ok, errors: r.errors, auth: auth_state }; }, args: { ...S } },
	pin:    { call: (req) => do_pin(req.args.policy, req.args.exit), args: { policy: '', exit: '', ...S } },
	switch: { call: (req) => do_pin(req.args.policy, req.args.exit), args: { policy: '', exit: '', ...S } },
	unpin:  { call: (req) => do_pin(req.args.policy, null), args: { policy: '', ...S } },
	notify_test: { call: () => ({ queued: notify.test() }), args: { ...S } },
	// LuCI actions: run the CLI asynchronously (deferred reply), so probes keep running meanwhile
	engine_add:      { call: (req) => cli_job(req, [ 'engine-add', req.args.name, length(req.args.link ?? '') ? secret_arg(req.args.link) : '', ...(length(req.args.via ?? '') ? [ req.args.via ] : []) ]), args: { name: '', link: '', via: '', ...S } },
	warp_register:   { call: (req) => cli_job(req, [ ...warp_args(req.args.name), ...(req.args.awg ? [ 'awg=1' ] : []) ]), args: { name: '', awg: false, ...S } },
	warp_unregister: { call: (req) => cli_job(req, [ 'warp-unregister', req.args.name ]), args: { name: '', ...S } },
	// backup / restore of Detour's settings (backup.uc); the password reaches the CLI in a file of mode 600
	backup_create:   { call: (req) => backup_job(req, () => { try { traffic.flush(); } catch (e) { } return [ 'backup', BACKUP_OUT ]; }), args: { password: '', ...S } },
	backup_check:    { call: (req) => backup_job(req, () => [ 'restore', RESTORE_IN ]), args: { password: '', ...S } },
	backup_restore:  { call: (req) => backup_job(req, () => { try { traffic.flush(); } catch (e) { } return [ 'restore', RESTORE_IN, '--apply' ]; }, true), args: { password: '', ...S } },
	sub_update:      { call: (req) => cli_job(req, [ 'sub-update', ...(length(req.args.name ?? '') ? [ req.args.name ] : []) ]), args: { name: '', ...S } },
	exits_info:      { call: () => exits_info(), args: { ...S } },
	exit_check:      { call: (req) => exit_check(req), args: { name: '', ...S } },
	sub_state:       { call: (req) => sub_state(req), args: { name: '', ...S } },
	sub_check:       { call: (req) => sub_check(req), args: { name: '', index: 0, ...S } },
	exit_remove:     { call: (req) => cli_job(req, [ 'exit-remove', req.args.name ], true), args: { name: '', ...S } },
	exit_pick:       { call: (req) => cli_job(req, [ 'exit-pick', req.args.name, length(req.args.key ?? '') ? req.args.key : '-' ]), args: { name: '', key: '', ...S } },
	exit_config_get: { call: (req) => exitui.outbound_get(req.args.name), args: { name: '', ...S } },
	exit_config_set: { call: (req) => length(req.args.config ?? '') ? cli_job(req, [ 'exit-config-set', req.args.name, secret_arg(req.args.config) ], true) : { error: 'missing argument' }, args: { name: '', config: '', ...S } },
	exit_set_link:   { call: (req) => length(req.args.link ?? '') ? cli_job(req, [ 'exit-set-link', req.args.name, secret_arg(req.args.link) ], true) : { error: 'missing argument' }, args: { name: '', link: '', ...S } },
	// stage 2: an exit from any link / key / file, export, speed, why it does not work
	exit_parse:      { call: (req) => exitadd.candidates(req.args.text), args: { text: '', ...S } },
	exit_add:        { call: (req) => length(req.args.text ?? '') ? cli_job(req, [ 'exit-add', secret_arg(req.args.text),
		(type(req.args.picks) == 'array' && length(req.args.picks)) ? join(',', map(req.args.picks, (x) => '' + int(x))) : '-',
		req.args.name, length(req.args.via ?? '') ? req.args.via : '-', length(req.args.label ?? '') ? req.args.label : '-',
		replace(join(',', map((type(req.args.engines) == 'array') ? req.args.engines : [], (e) => (e == 'singbox' || e == 'xray') ? e : '')), /^,*$/, '-') ], true)
		: { error: 'missing argument' }, args: { text: '', picks: [], name: '', via: '', label: '', engines: [], ...S } },
	exit_export:     { call: (req) => exitui.export_exit(req.args.name), args: { name: '', ...S } },
	exit_speed:      { call: (req) => exit_speed(req), args: { name: '', direct: false, ...S } },
	sub_speed:       { call: (req) => sub_speed(req), args: { name: '', index: 0, ...S } },
	exit_diag:       { call: (req) => { req.defer(); diag_exit(req.args.name ?? '', (d) => req.reply(d)); }, args: { name: '', ...S } },
	site_explain:    { call: (req) => site_explain(req), args: { target: '', mac: '', ...S } },
	site_check:      { call: (req) => site_check(req), args: { target: '', exit: '', ...S } },
	devices:         { call: () => devices.list(), args: { ...S } },
	// stage 4.2: what a device asks for (tcpdump for a few minutes)
	dns_watch:       { call: (req) => dnswatch.start(req.args.mac, req.args.seconds), args: { mac: '', seconds: 120, ...S } },
	dns_watch_stop:  { call: () => dnswatch.stop(), args: { ...S } },
	dns_log:         { call: (req) => ({ available: dnswatch.available(), ...dnswatch.log(req.args.mac) }), args: { mac: '', ...S } },
	catalog_names:   { call: () => catalog_names(), args: { ...S } },
	dns_providers:   { call: () => ({ providers: dnsprov.list() }), args: { ...S } },
	catalog_refresh: { call: (req) => catalog_refresh(req), args: { ...S } },
	rates:           { call: () => rates(), args: { ...S } },
	traffic:         { call: (req) => traffic.report(index([ 'day', 'days3', 'week', 'month', 'year' ], req.args.period) >= 0 ? req.args.period : 'day'), args: { period: '', ...S } },
	exit_set_via:    { call: (req) => cli_job(req, [ 'exit-set-via', req.args.name, length(req.args.via ?? '') ? req.args.via : '-' ], true), args: { name: '', via: '', ...S } },
	// LuCI "Components": the packages Detour uses; an action runs detached (see pkgs.uc), LuCI follows pkg_job
	pkg_list:        { call: () => pkgs.list(), args: { ...S } },
	pkg_job:         { call: () => ({ job: pkgs.job() }), args: { ...S } },
	pkg_run:         { call: (req) => pkgs.start(req.args.action, req.args.packages), args: { action: '', packages: '', ...S } },
	lists_update:    { call: (req) => cli_job(req, [ 'lists-update', ...(length(req.args.name ?? '') ? [ req.args.name ] : []) ]), args: { name: '', ...S } },
	// the log: its level (verbose ends by itself after 24 h) and an archive of everything for a diagnosis
	log_level:       { call: (req) => length(req.args.level ?? '') ? set_log_level(req.args.level) : log_state(), args: { level: '', ...S } },
	logs_archive:    { call: (req) => cli_job(req, [ 'logs-archive' ]), args: { ...S } },
}));

// netifd: put the exit route back on ifup (netifd does not restore routes in our tables)
conn.listener('network.interface', function(t, data) {
	if (off) return;
	for (let e in cfg.exits) {
		if (data?.interface != e.iface) continue;
		if (data.action == 'ifup') { net.ensure_route(e); ev(sprintf('exit %s: %s up, route restored', e.name, e.iface)); }
		else if (data.action == 'ifdown') { net.drop_route(e); ev(sprintf('exit %s: %s down', e.name, e.iface)); }
		evaluate();
	}
});

// WARP exits: check the colo every warp_check seconds (default 15 min); a WARP exit that stopped
// answering gets checked at once (at most every 2 min) - it may have landed on a filtering colo.
let warp_busy = false;
const warp_last = {};
function warp_check() {
	if (warp_busy) return;
	// '0' = off; the first check waits 2 min after start (exits come up, a pick at boot would cut the tunnel)
	const every = int(cursor().get('detour', 'main', 'warp_check') ?? 900);
	if (every <= 0 || time() - t0 < 120) return;
	for (let e in cfg.exits) {
		if (!e.enabled || cursor().get('detour', e.name, 'warp') != '1' || !net.dev_up(e.device)) continue;
		const last = warp_last[e.name] ?? 0;
		const due = (time() - last >= every) || (!healthy(e) && health[e.name]?.seen && time() - last >= 120);
		if (!due) continue;
		warp_busy = true;
		warp_last[e.name] = time();
		// its answer is the file below; what it prints would go to the syslog through procd
		uloop.process('/bin/sh', [ '-c', 'exec /usr/sbin/detour warp-pick ' + core.shq(e.name) + ' >/dev/null 2>&1' ], {}, function(code) {
			warp_busy = false;
			let r = null;
			try { r = json(fs.readfile(sprintf('%s/warp-pick-%s.json', core.RUN, e.name))); } catch (x) { }
			core.vlog('warp', sprintf('%s: check -> %s', e.name, r ? sprintf('%J', r) : 'no answer, code ' + code));
			if (r?.moved) {
				ev(sprintf('WARP %s moved to %s (colo %s, was %s)', e.name, r.endpoint, r.colo, r.from ?? '?'));
				tell('switch', 'warp:' + e.name, sprintf(_('WARP %s moved to the Cloudflare point %s (it was %s)'), watch.q(e.label ?? e.name), r.colo, r.from ?? _('no answer')));
			}
			else if (r?.note) ev(sprintf('WARP %s: %s', e.name, r.note));
		});
		return;   // one at a time
	}
}

// A probe costs traffic (an HTTPS request through the exit, about 5 KB: every 2 s that is ~200 MB a day per exit),
// so a working exit is not probed every probe_period - its device counters already tell. Something came back
// (rx grew): it works, a real probe once a minute. Only sent, nothing back (tx grew, rx did not): probed now, so
// a failure under load is noticed as fast as before. Idle: every main.probe_idle seconds. A failing or not yet
// known exit is probed every probe_period.
const probe_st = {};
function probe_due(e) {
	const now = time();
	const st = (probe_st[e.name] ??= { at: 0, rx: null, tx: null });
	const ctr = (k) => int(fs.readfile(sprintf('/sys/class/net/%s/statistics/%s_bytes', e.device, k)) ?? -1);
	const rx = ctr('rx'), tx = ctr('tx');
	const grew_rx = st.rx != null && rx > st.rx, grew_tx = st.tx != null && tx > st.tx;
	st.rx = rx; st.tx = tx;
	const h = health[e.name];
	let due;
	if (!h?.seen || h.fails > 0 || !healthy(e)) due = true;
	else if (grew_rx) due = now - st.at >= 60;
	else if (grew_tx) due = true;
	else due = now - st.at >= cfg.main.probe_idle;
	if (due) st.at = now;
	return due;
}

let tick;
let n = 0;
tick = uloop.timer(500, function() {
	if (off) {
		fs.writefile(core.RUN + '/heartbeat', sprintf('%d\n', time()));
		tick.set(cfg.main.probe_period * 1000);
		return;
	}
	for (let e in cfg.exits) {
		if (!e.probe) health[e.name] ??= { seen: true, ok: true, fails: 0 };
		if (probe_due(e)) probe(e);
		// devices can appear late (tun of a proxy engine): keep the route in place
		if (e.enabled && net.dev_up(e.device)) net.ensure_route(e);
	}
	engines.devices_up();
	evaluate();
	alerts();
	try { watch.tick(cfg.exits, healthy, ready()); } catch (x) { core.log('watch: ' + x); }
	if (notify.queued()) {
		const devs = [];
		for (let e in cfg.exits) if (healthy(e)) push(devs, e.device);
		notify.flush(devs);
	}
	fs.writefile(core.RUN + '/heartbeat', sprintf('%d\n', time()));
	if (n++ % 30 == 0) {
		const a = guard();
		if (a != 'ok') ev('2FA guard: ' + a);
		auth_state = a;
	}
	warp_check();
	tick.set(cfg.main.probe_period * 1000);
});

let iptick;
iptick = uloop.timer(20000, function() {
	try { ip_watch(); } catch (x) { core.log('ip watch: ' + x); }
	try { log_sync(); } catch (x) { core.log('log: ' + x); }
	iptick.set(30000);
});

// traffic by device and exit (traffic.uc): every 5 min, the first step soon after start takes the starting point
let ttick;
ttick = uloop.timer(15000, function() {
	try { traffic.tick(cfg, (n) => cursor().get('detour', n + '_eng', 'via')); } catch (x) { core.log('traffic: ' + x); }
	ttick.set(1000 * (int(cursor().get('detour', 'main', 'traffic_period') ?? 300) || 300));   // the lab tests use a short one
});

uloop.run();
// SIGTERM (stop, reboot, upgrade) ends the loop: today's traffic so far goes to flash
try { traffic.flush(); } catch (x) { }
try { dnswatch.stop(); } catch (x) { }
