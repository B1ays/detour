#!/usr/bin/ucode
// detour CLI: fw-start | fw-stop | purge | render | check | status | reload | pin <policy> <exit> | unpin <policy>
'use strict';

import * as ubus from 'ubus';
import * as core from 'detour.core';
import * as nft from 'detour.nft';
import * as fw from 'detour.fw';
import * as dns from 'detour.dns';
import * as engines from 'detour.engines';
import * as links from 'detour.links';
import * as warp from 'detour.warp';
import * as warppick from 'detour.warppick';
import * as subs from 'detour.subs';
import * as backup from 'detour.backup';
import * as exitui from 'detour.exitui';
import * as exitadd from 'detour.exitadd';
import * as listmem from 'detour.listmem';
import * as logs from 'detour.logs';
import * as socks from 'detour.socks';
import * as fs from 'fs';

const cmd = ARGV[0];

// "@<file>": the text (a configuration, a link, keys) comes in a file the daemon wrote (mode 600), not on the
// command line where any process could read it; the file is removed once read
function arg_text(a) {
	if (substr(a ?? '', 0, 1) != '@') return a;
	const f = substr(a, 1);
	if (!match(f, /^\/tmp\/detour\/in-[A-Za-z0-9_-]+$/)) { warn('detour: bad input file\n'); exit(1); }
	const t = fs.readfile(f);
	fs.unlink(f);
	return t ?? '';
}

function call(method, args) {
	const c = ubus.connect();
	const r = c ? c.call('detour', method, args ?? {}) : null;
	if (r == null) { warn('detour: daemon not running\n'); exit(2); }
	printf('%.J\n', r);
	exit(r?.error ? 1 : 0);
}

switch (cmd) {
case 'fw-start': {
	const r = fw.start();
	for (let e in r.errors) warn('detour: ' + e + '\n');
	exit(r.ok ? 0 : 1);
}
case 'fw-stop':
	fw.stop(true);
	exit(0);
case 'purge':
	fw.purge();
	exit(0);
case 'render': {
	const cfg = core.load();
	dns.prepare(cfg);
	print(nft.render(cfg, fw.active_map(cfg), { skip_uid: fw.skip_uid(cfg) }));
	print('# --- dnsmasq\n', dns.render_conf(cfg));
	exit(0);
}
case 'check': {
	const cfg = core.load();
	for (let e in cfg.errors) print(e, '\n');
	printf('%d exits, %d policies, %d errors\n', length(cfg.exits), length(cfg.policies), length(cfg.errors));
	exit(length(cfg.errors) ? 1 : 0);
}
case 'engines': {
	const r = engines.prepare();
	for (let e in r.errors) warn('detour: ' + e + '\n');
	for (let l in r.lines) print(l, '\n');
	exit(0);
}
case 'socks': {
	// the local SOCKS5 proxy for the init script: "<binary>\t<args>" (its config written, mode 600), nothing when off
	const r = socks.prepare(core.load());
	if (r?.error) { warn('detour: ' + r.error + '\n'); exit(0); }
	if (r) print(r.bin, '\t', r.args, '\n');
	exit(0);
}
case 'dom-forget': {
	// detour dom-forget <file>: domains taken off a policy, "<policy id> <domain>" a line (detourd, after a reload,
	// in the background): their addresses leave the policy's sets unless its lists still cover them; the file goes
	const f = ARGV[1] ?? '';
	const keys = filter(map(split(fs.readfile(f) ?? '', '\n'), (l) => trim(l)), (x) => length(x));
	if (match(f, /^\/tmp\/detour\/forget-/)) fs.unlink(f);
	printf('%J\n', dns.forget(keys));
	exit(0);
}
case 'dns-upstreams': {
	// the encrypted resolvers dnsproxy asks (init script): line 1 the upstreams, line 2 the bootstrap servers -
	// a known provider's (main.dns_provider + dns_proto) or the addresses given
	const m = core.load().main;
	print(join(' ', m.dns_fallback), '\n', join(' ', m.dns_bootstrap), '\n');
	exit(0);
}
case 'link': {
	// detour link '<share link>' [outbound file]: print (or write, mode 600) a sing-box outbound
	const r = links.parse(ARGV[1]);
	if (r.error) { warn('detour: ' + r.error + '\n'); exit(1); }
	const text = sprintf('%.J\n', r.outbound);
	if (ARGV[2]) { fs.writefile(ARGV[2], text); fs.chmod(ARGV[2], 0600); }
	else print(text);
	exit(0);
}
case 'engine-add': {
	// detour engine-add <name> '<share link>' [via-exit]
	const r = engines.add_from_link(ARGV[1], arg_text(ARGV[2]), ARGV[3]);
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'warp-register': {
	// detour warp-register <name> [via=EXIT] [api=URL] [peer=KEY] [port=N] [awg=1]   (api/peer: lab stubs only)
	const o = { name: ARGV[1] };
	for (let a in slice(ARGV, 2)) {
		const i = index(a, '=');
		if (i > 0) o[substr(a, 0, i)] = substr(a, i + 1);
	}
	const r = warp.register({ name: o.name, api: o.api, peer_key: o.peer, port: o.port ? int(o.port) : null, awg: o.awg == '1', mask: o.mask, via: o.via });
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'sub-update': {
	// detour sub-update [name]
	// --due (hourly cron): only those whose own interval has passed
	const r = (ARGV[1] == '--due') ? subs.update_due() : ARGV[1] ? subs.update(ARGV[1]) : subs.update_all();
	printf('%.J\n', r);
	exit((type(r) == 'object' && r.error) ? 1 : 0);
}
case 'warp-pick': {
	// detour warp-pick <name> [--force]: check the colo through the tunnel, move away from DME
	const r = warppick.pick(ARGV[1], ARGV[2] == '--force');
	printf('%.J\n', r);
	fs.writefile(sprintf('%s/warp-pick-%s.json', core.RUN, ARGV[1]), sprintf('%J', r));
	exit(r.error ? 1 : 0);
}
case 'warp-unregister': {
	const r = warp.unregister(ARGV[1]);
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'backup':
case 'restore': {
	// detour backup <out file> <password: @file | file>
	// detour restore <backup file> <password: @file | file> [--apply]   without --apply: only show what it holds
	// the password file: "@/tmp/detour/in-*" from the daemon (removed once read), or any file of yours
	const p = ARGV[2] ?? '';
	const pw = (substr(p, 0, 1) == '@') ? arg_text(p) : fs.readfile(p);
	if (pw == null) { warn('detour: no password file
'); exit(1); }
	const pf = sprintf('%s/.pw-%d', core.RUN, time());
	fs.mkdir(core.RUN);
	fs.writefile(pf, ''); fs.chmod(pf, 0600); fs.writefile(pf, pw);
	let r;
	if (cmd == 'backup') r = backup.create(ARGV[1] ?? '', pf);
	else {
		const o = backup.open(ARGV[1] ?? '', pf);
		if (o.error) r = o;
		else if (index(ARGV, '--apply') >= 0) r = backup.apply(o, pf);
		else r = { ...backup.preview(o), note: 'dry run - nothing changed; add --apply to restore' };
	}
	fs.unlink(pf);
	backup.cleanup();
	printf('%.J
', r);
	exit(r.error ? 1 : 0);
}
case 'lists-update':
	// detour lists-update [--restore|--missing] [name...]
	exit(system([ '/usr/libexec/detour/lists-update', ...slice(ARGV, 1) ]));
case 'lists-mem': {
	// detour lists-mem                                         the memory budget of the lists (JSON, bytes)
	// detour lists-mem check <list> <kind> <entries> <target> <accepted>   bytes it adds; exit 1 + the reason when it does not fit
	// detour lists-mem rawmax <accepted>                        the biggest download a list may take now (bytes)
	if (ARGV[1] == 'check') {
		const why = listmem.check(ARGV[2], ARGV[3], int(ARGV[4] ?? 0), ARGV[5], int(ARGV[6] ?? 0));
		if (why) { print(why, '
'); exit(1); }
		print(listmem.delta(ARGV[2], ARGV[3], int(ARGV[4] ?? 0)), '
');   // what it adds: the caller sums a run
		exit(0);
	}
	if (ARGV[1] == 'rawmax') { print(listmem.rawmax(int(ARGV[2] ?? 0)), '
'); exit(0); }
	printf('%.J
', listmem.budget()); exit(0);
}
case 'exit-info': printf('%.J\n', exitui.info()); break;
case 'logs-archive': {
	// detour logs-archive: everything for a diagnosis in one .tar.gz (logs.uc), secrets masked
	const r = logs.archive();
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'exit-remove': {
	// detour exit-remove <exit>: the exit with its engine, interface, peers, zone entry, subscription
	const r = exitui.remove(ARGV[1]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-pick': {
	// detour exit-pick <subscription exit> <server key | ->  ("-" = automatic)
	const r = exitui.pick(ARGV[1], (ARGV[2] == '-') ? null : ARGV[2]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-config-set': {
	// detour exit-config-set <exit> '<outbound JSON>'
	const r = exitui.outbound_set(ARGV[1], arg_text(ARGV[2]));
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-set-link': {
	// detour exit-set-link <exit> '<share link>'
	const r = exitui.set_link(ARGV[1], arg_text(ARGV[2]));
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-parse': {
	// detour exit-parse <file|@file>: what a link / key / config / JSON / Clash YAML holds (no secrets)
	const t = (substr(ARGV[1] ?? '', 0, 1) == '@') ? arg_text(ARGV[1]) : fs.readfile(ARGV[1] ?? '');
	const r = exitadd.candidates(t);
	printf('%.J
', r); exit(r.error ? 1 : 0);
}
case 'exit-add': {
	// detour exit-add <file|@file> <picks: 0,2 | -> <name> [via|-] [label|-] [engines by candidate: singbox,,xray]
	const t = (substr(ARGV[1] ?? '', 0, 1) == '@') ? arg_text(ARGV[1]) : fs.readfile(ARGV[1] ?? '');
	const picks = (ARGV[2] && ARGV[2] != '-') ? map(split(ARGV[2], ','), (x) => int(x)) : [];
	const engs = (length(ARGV[6] ?? '') && ARGV[6] != '-') ? split(ARGV[6], ',') : null;
	const r = exitadd.add(t, picks, ARGV[3], (ARGV[4] && ARGV[4] != '-') ? ARGV[4] : null,
		(ARGV[5] && ARGV[5] != '-') ? ARGV[5] : null, engs);
	printf('%.J
', r); exit(r.error ? 1 : 0);
}
case 'exit-set-via': {
	// detour exit-set-via <exit> <via-exit | ->: a proxy exit dials its server through another exit, or directly
	const r = exitui.set_via(ARGV[1], (ARGV[2] && ARGV[2] != '-') ? ARGV[2] : null);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-export': {
	// detour exit-export <exit>: a share link or a .conf (with its keys), and a QR code (qrencode)
	const r = exitui.export_exit(ARGV[1]);
	printf('%.J
', r); exit(r.error ? 1 : 0);
}
case 'status': call('status'); break;
case 'reload': call('reload'); break;
case 'pin': call('pin', { policy: ARGV[1], exit: ARGV[2] }); break;
case 'unpin': call('unpin', { policy: ARGV[1] }); break;
default:
	warn('usage: detour fw-start|fw-stop|purge|render|check|status|reload|pin <policy> <exit>|unpin <policy>\n');
	exit(1);
}
