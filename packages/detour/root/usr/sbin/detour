#!/usr/bin/ucode
// detour CLI: fw-start | fw-stop | purge | render | check | status | reload | pin <policy> <exit> | unpin <policy>
'use strict';

import * as ubus from 'ubus';
import * as core from 'detour.core';
import * as nft from 'detour.nft';
import * as fw from 'detour.fw';
import * as dns from 'detour.dns';
import * as engines from 'detour.engines';
import * as links from 'detour.links';
import * as warp from 'detour.warp';
import * as warppick from 'detour.warppick';
import * as subs from 'detour.subs';
import * as importer from 'detour.importer';
import * as exitui from 'detour.exitui';
import * as fs from 'fs';

const cmd = ARGV[0];

function call(method, args) {
	const c = ubus.connect();
	const r = c ? c.call('detour', method, args ?? {}) : null;
	if (r == null) { warn('detour: daemon not running\n'); exit(2); }
	printf('%.J\n', r);
	exit(r?.error ? 1 : 0);
}

switch (cmd) {
case 'fw-start': {
	const r = fw.start();
	for (let e in r.errors) warn('detour: ' + e + '\n');
	exit(r.ok ? 0 : 1);
}
case 'fw-stop':
	fw.stop(true);
	exit(0);
case 'purge':
	fw.purge();
	exit(0);
case 'render': {
	const cfg = core.load();
	dns.prepare(cfg);
	print(nft.render(cfg, fw.active_map(cfg), { skip_uid: fw.skip_uid(cfg) }));
	print('# --- dnsmasq\n', dns.render_conf(cfg));
	exit(0);
}
case 'check': {
	const cfg = core.load();
	for (let e in cfg.errors) print(e, '\n');
	printf('%d exits, %d policies, %d errors\n', length(cfg.exits), length(cfg.policies), length(cfg.errors));
	exit(length(cfg.errors) ? 1 : 0);
}
case 'engines': {
	const r = engines.prepare();
	for (let e in r.errors) warn('detour: ' + e + '\n');
	for (let l in r.lines) print(l, '\n');
	exit(0);
}
case 'link': {
	// detour link '<share link>' [outbound file]: print (or write, mode 600) a sing-box outbound
	const r = links.parse(ARGV[1]);
	if (r.error) { warn('detour: ' + r.error + '\n'); exit(1); }
	const text = sprintf('%.J\n', r.outbound);
	if (ARGV[2]) { fs.writefile(ARGV[2], text); fs.chmod(ARGV[2], 0600); }
	else print(text);
	exit(0);
}
case 'engine-add': {
	// detour engine-add <name> '<share link>' [via-exit]
	const r = engines.add_from_link(ARGV[1], ARGV[2], ARGV[3]);
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'warp-register': {
	// detour warp-register <name> [via=EXIT] [api=URL] [peer=KEY] [port=N] [awg=1]   (api/peer: lab stubs only)
	const o = { name: ARGV[1] };
	for (let a in slice(ARGV, 2)) {
		const i = index(a, '=');
		if (i > 0) o[substr(a, 0, i)] = substr(a, i + 1);
	}
	const r = warp.register({ name: o.name, api: o.api, peer_key: o.peer, port: o.port ? int(o.port) : null, awg: o.awg == '1', mask: o.mask, via: o.via });
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'sub-update': {
	// detour sub-update [name]
	// --due (hourly cron): only those whose own interval has passed
	const r = (ARGV[1] == '--due') ? subs.update_due() : ARGV[1] ? subs.update(ARGV[1]) : subs.update_all();
	printf('%.J\n', r);
	exit((type(r) == 'object' && r.error) ? 1 : 0);
}
case 'warp-pick': {
	// detour warp-pick <name> [--force]: check the colo through the tunnel, move away from DME
	const r = warppick.pick(ARGV[1], ARGV[2] == '--force');
	printf('%.J\n', r);
	fs.writefile(sprintf('%s/warp-pick-%s.json', core.RUN, ARGV[1]), sprintf('%J', r));
	exit(r.error ? 1 : 0);
}
case 'warp-unregister': {
	const r = warp.unregister(ARGV[1]);
	printf('%.J\n', r);
	exit(r.error ? 1 : 0);
}
case 'import': {
	// detour import <backup.tar.gz | state dir> [--apply] [prefix=st_]
	const u = importer.unpack(ARGV[1] ?? '');
	if (u.error) { warn('detour: ' + u.error + '\n'); exit(1); }
	const p = importer.plan(u.dir);
	const apply = index(ARGV, '--apply') >= 0;
	let prefix = 'st_';
	for (let a in ARGV) if (substr(a, 0, 7) == 'prefix=') prefix = substr(a, 7);
	const out = {
		exits: map(p.exits, (e) => sprintf('%s%s: %s from %s%s', prefix, e.name, e.kind, e.from, e.via ? ' (connects through ' + prefix + e.via + ')' : '')),
		policies: map(p.policies, (x) => sprintf('%sp_%s via %s: %d addresses, %d domains, %d devices%s', prefix, x.name, join(' -> ', x.exits), length(x.dst), length(x.domain), length(x.device),
			length(x.port ?? []) ? sprintf(', ports %s', join(' ', x.port)) : '')),
		direct: sprintf('%d addresses, %d devices, %d domains', length(p.direct.dst), length(p.direct.device), length(p.direct.domain)),
		lists: map(p.lists, (l) => sprintf('%s%s -> %s: %s%s (from %s)', prefix, l.name, l.policy, join(' ', l.urls), l.text ? ' + local entries' : '', l.from)),
		subscriptions: map(p.subs, (s) => sprintf('%s%s: %s (the address is kept secret)', prefix, s.name, s.label)),
		notify: p.notify ? 'Telegram' : null,
		dns: p.dns ? sprintf('%s (%s)%s', p.dns.name, join(' ', p.dns.fallback), p.dns.mode ? ', encrypt always' : '') : null,
		dhcp_hosts: length(p.hosts),
		not_carried_over: map(p.skipped, (s) => s.what + ': ' + s.why),
	};
	if (apply) out.applied = importer.apply(p, prefix);
	else out.note = 'dry run - nothing changed; add --apply to write the settings';
	printf('%.J\n', out);
	exit(0);
}
case 'lists-update':
	// detour lists-update [--restore|--missing] [name...]
	exit(system([ '/usr/libexec/detour/lists-update', ...slice(ARGV, 1) ]));
case 'sshtun': {
	// detour sshtun keygen|pubkey|test|forget|status - the panel tunnel to a VPS (/usr/libexec/detour/sshtun)
	const v = ARGV[1];
	if (index([ 'keygen', 'pubkey', 'test', 'forget', 'status' ], v) < 0) { warn('usage: detour sshtun keygen|pubkey|test|forget|status
'); exit(2); }
	const st = () => { try { return json(core.run('/bin/sh /usr/libexec/detour/sshtun status').out); } catch (e) { return {}; } };
	if (v == 'status') { printf('%.J
', st()); exit(0); }
	const r = core.run('/bin/sh /usr/libexec/detour/sshtun ' + v + ' 2>&1');
	const out = trim(r.out);
	let res;
	if (v == 'test') res = (out == 'ok') ? { ok: true, host_fp: st().host_fp } : { error: out };
	else if (v == 'keygen' || v == 'pubkey') res = (r.code == 0 && length(out)) ? { pubkey: out } : { error: out || 'no key' };
	else res = { ok: true, message: out };
	// the tunnel instance starts only once the server key is known (test) and stops when it is forgotten
	if ((v == 'test' && res.ok) || v == 'forget') core.run('/etc/init.d/detour start');
	printf('%.J
', res);
	exit(res.error ? 1 : 0);
}
case 'exit-info': printf('%.J\n', exitui.info()); break;
case 'exit-remove': {
	// detour exit-remove <exit>: the exit with its engine, interface, peers, zone entry, subscription
	const r = exitui.remove(ARGV[1]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-pick': {
	// detour exit-pick <subscription exit> <server key | ->  ("-" = automatic)
	const r = exitui.pick(ARGV[1], (ARGV[2] == '-') ? null : ARGV[2]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-config-set': {
	// detour exit-config-set <exit> '<outbound JSON>'
	const r = exitui.outbound_set(ARGV[1], ARGV[2]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'exit-set-link': {
	// detour exit-set-link <exit> '<share link>'
	const r = exitui.set_link(ARGV[1], ARGV[2]);
	printf('%.J\n', r); exit(r.error ? 1 : 0);
}
case 'status': call('status'); break;
case 'reload': call('reload'); break;
case 'pin': call('pin', { policy: ARGV[1], exit: ARGV[2] }); break;
case 'unpin': call('unpin', { policy: ARGV[1] }); break;
default:
	warn('usage: detour fw-start|fw-stop|purge|render|check|status|reload|pin <policy> <exit>|unpin <policy>\n');
	exit(1);
}
