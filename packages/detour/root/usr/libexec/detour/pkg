#!/bin/sh
# One package action of LuCI "Components", started detached by the daemon (detour.pkgs):
#   pkg <update|install|upgrade|remove> [package...]
# The log and the state are in /tmp/detour/pkg: state.json { action, packages, pid, started, running, code, finished }.
# install / upgrade read the index first (apk update); only the named packages are upgraded, never the system.
# out of the daemon's cgroup first: procd ends every process of a service's cgroup when it stops the service,
# and an upgrade of Detour (or a restart meanwhile) must not end the action that does it
[ -w /sys/fs/cgroup/cgroup.procs ] && echo $$ > /sys/fs/cgroup/cgroup.procs 2>/dev/null
D=/tmp/detour/pkg
mkdir -p "$D"
act=$1; shift
pkgs="$*"
state() {   # state <running true|false> [code]
	printf '{"action":"%s","packages":"%s","pid":%d,"started":%d,"running":%s,"code":%s,"finished":%s}\n' \
		"$act" "$pkgs" $$ "$T0" "$1" "${2:-null}" "$([ "$1" = false ] && date +%s || echo null)" > "$D/state.json.tmp"
	mv "$D/state.json.tmp" "$D/state.json"
}
T0=$(date +%s)
. /usr/share/detour/log.sh
vlog pkg "$act $pkgs: started"
: > "$D/log"
state true
exec >> "$D/log" 2>&1

# apk update: a feed out of reach (one on a PC that is off, a mirror that is down) is a warning, not the end - the
# others are read, and "apk upgrade" is told to go on without it (it refuses otherwise; "apk add" does not need it)
refresh() {
	out=$(apk update 2>&1); r=$?
	printf '%s\n' "$out"
	[ "$r" = 0 ] && return 0
	down=$(printf '%s\n' "$out" | sed -n 's/^WARNING: updating and opening \([^ ]*\): .*/\1/p')
	n=$(printf '%s\n' "$out" | sed -n 's/.*; \([0-9]*\) distinct packages available.*/\1/p')
	[ -n "$down" ] && [ "${n:-0}" -gt 0 ] || return "$r"
	miss=--force-missing-repositories
	echo "out of reach now, their packages are not seen:"
	printf '  %s\n' $down
	return 0
}

# a package installed from a file ("apk add ./x.apk": a test build) is pinned to that file in /etc/apk/world
# ("name><checksum"): "apk upgrade" keeps it for ever and says OK. "apk add name" turns it back into a plain name.
unpin() {
	for p in $pkgs; do
		grep -q "^$p><" /etc/apk/world 2>/dev/null || continue
		echo "$p was installed from a file: it follows the feeds again"
		apk add $miss "$p" >/dev/null || return 1
	done
}

rc=0; some=; miss=
case "$act" in
update)  refresh || rc=$? ;;
install)
	if ! refresh; then rc=1
	elif ! apk add $miss $pkgs; then
		rc=1
		# apk installs all or nothing: one package these repositories lack (a restore of a backup from another
		# firmware: its kernel module, its tools) must not keep the others out - one by one, the result still failed
		set -- $pkgs
		if [ $# -gt 1 ]; then
			echo "together they did not install - one by one:"
			for p in $pkgs; do apk add $miss "$p" && some=1; done
		fi
	fi ;;
upgrade) refresh && unpin && apk upgrade $miss $pkgs || rc=$? ;;
remove)  apk del $pkgs || rc=$? ;;
*)       echo "unknown action: $act"; rc=2 ;;
esac

if { [ "$rc" = 0 ] || [ -n "$some" ]; } && [ "$act" != update ]; then
	# LuCI forgets its menu and module caches (a LuCI package came or went)
	rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
	# Detour sees a new or removed engine, dnsproxy, AmneziaWG at once (its own upgrade restarts it anyway): the
	# service's reload, not only the daemon's - the engines and dnsproxy are procd instances of the init script, and
	# an engine whose binary was missing has none until the script runs again
	case " $pkgs " in *" detour "*) ;; *) /etc/init.d/detour reload >/dev/null 2>&1 ;; esac
	[ "$rc" = 0 ] && echo "done" || echo "failed (code $rc): some of them are installed"
else
	[ "$rc" = 0 ] && echo "done" || echo "failed (code $rc)"
fi
vlog pkg "$act $pkgs: code $rc in $(( $(date +%s) - T0 )) s"
state false "$rc"
exit "$rc"
