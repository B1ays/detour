#!/bin/sh
# Big IP / domain lists (stock: lists-update.sh / iplist-update.sh) for OpenWrt.
#   config list 'ru'
#     option policy 'vpn'            # a policy name (a VPN, "Block" or "Directly" one)
#     list url 'https://iplist.opencck.org/?format=text&data=cidr4'
#     option file '/etc/detour/lists/ru.txt'     # optional local part
#     option kind 'auto'             # auto | cidr | domain
#     option min_lines '10'          # fewer lines = treat the update as a failure
#     option enabled '1'
# Memory (listmem.uc): a download is capped by what is free; a list that would not fit (all lists under a cap, a
# reserve left free after loading - counted for what the whole run adds) is refused like a failed download: the
# previous data stays and the reason goes to the status. A list that does not grow is never refused; --restore
# (boot) loads what was accepted before without asking.
# Data lives in RAM (/tmp/detour/lists); a snapshot goes to flash only up to MAXSNAP lines, so a
# huge de-aggregated list cannot fill the flash. A failed or suspicious download keeps the
# previous data (RAM, then snapshot) - the routing never empties because a source is down.
# CIDR lists -> nft set lst4_p<id> of the policy (one atomic transaction per set);
# domain lists -> dnsmasq nftset files in every instance's conf-dir (+ AAAA suppression for policies).
#   lists-update [--restore] [name...]   --restore: no downloads, load from RAM/snapshots (boot)
#   lists-update --catalog               only refresh the names of the v2fly categories (LuCI catalogue)
# Data from jsDelivr is taken at the source's current commit (@<sha>), not its branch: jsDelivr keeps a branch
# up to 12 h old, so "the source changed" and the data would disagree (as stock geo.sh does). The commit and
# its date come from the GitHub API; when it does not answer, the branch is used as before.
. /lib/functions.sh

RUN=/tmp/detour/lists
SNAP=/etc/detour/lists
MAXSNAP=${MAXSNAP:-40000}
T='inet detour'
mkdir -p "$RUN" "$SNAP"
V2NAMES=/etc/detour/v2fly-names.txt   # the v2fly categories as listed upstream (flash, written only when changed)

# the commit a jsDelivr GitHub path stands on now, cached for the run: "owner/repo@branch sha date"
upstream() {   # upstream owner repo branch -> "sha date" or nothing
	local k="$1/$2@$3" l j sha date
	l=$(grep -F "$k " "$RUN/.shas" 2>/dev/null | head -n1)
	[ -n "$l" ] && { echo "${l#* }"; return; }
	j=$(curl -fsS -m 15 -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$1/$2/commits/$3" 2>/dev/null)
	sha=$(echo "$j" | jsonfilter -e '@.sha' 2>/dev/null)
	date=$(echo "$j" | jsonfilter -e '@.commit.committer.date' 2>/dev/null)
	case "$sha" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;; *) echo "$k - -" >> "$RUN/.shas"; return ;; esac
	echo "$k $sha $date" >> "$RUN/.shas"
	echo "$sha $date"
}
# a jsDelivr GitHub URL at its branch -> the same at the current commit (unchanged when that is unknown);
# PIN_DATE: the date of that commit (for the status)
pin() {
	local u="$1" rest owner repo br path sd
	PIN_DATE=
	case "$u" in https://cdn.jsdelivr.net/gh/*/*@*/*) ;; *) echo "$u"; return ;; esac
	rest=${u#https://cdn.jsdelivr.net/gh/}
	owner=${rest%%/*}; rest=${rest#*/}
	repo=${rest%%@*}; rest=${rest#*@}
	br=${rest%%/*}; path=${rest#*/}
	case "$br" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) echo "$u"; return ;; esac
	sd=$(upstream "$owner" "$repo" "$br")
	case "$sd" in ''|-*) echo "$u"; return ;; esac
	PIN_DATE=${sd#* }
	echo "https://cdn.jsdelivr.net/gh/$owner/$repo@${sd%% *}/$path"
}

# the date of the commit a jsDelivr URL was pinned to in this run (empty when not pinned)
upstream_date() {
	local rest owner repo br l
	case "$1" in https://cdn.jsdelivr.net/gh/*/*@*/*) ;; *) return ;; esac
	rest=${1#https://cdn.jsdelivr.net/gh/}; owner=${rest%%/*}; rest=${rest#*/}; repo=${rest%%@*}; rest=${rest#*@}; br=${rest%%/*}
	l=$(grep -F "$owner/$repo@$br " "$RUN/.shas" 2>/dev/null | head -n1)
	l=${l##* }; [ "$l" = - ] || echo "$l"
}

# the names of all v2fly categories (the files in data/), from the jsDelivr listing (stock geo.sh v2fly_enumerate);
# a failed or odd answer keeps the previous names. First line: "# <the date of the commit>"
v2fly_names() {
	local sd ref t="$RUN/.v2names"
	sd=$(upstream v2fly domain-list-community master)
	case "$sd" in ''|-*) ref=master ;; *) ref=${sd%% *} ;; esac
	curl -fsS -m 60 "https://data.jsdelivr.com/v1/packages/gh/v2fly/domain-list-community@$ref?structure=flat" 2>/dev/null | \
		grep -oE '"/data/[^"/]+"' | sed 's|"/data/||; s|"$||' | grep -E '^[a-z0-9._!-]+$' | sort -u > "$t"
	# fewer than 500 names is not the real listing
	if [ "$(wc -l < "$t")" -ge 500 ]; then
		{ echo "# ${sd#* }"; cat "$t"; } > "$t.new"
		cmp -s "$t.new" "$V2NAMES" || { mkdir -p "${V2NAMES%/*}"; mv "$t.new" "$V2NAMES"; }
		rm -f "$t" "$t.new"; return 0
	fi
	rm -f "$t"; return 1
}
# the catalogue alone: no lock (a long list update must not hold it up), its own work file
if [ "$1" = --catalog ]; then RUN=$RUN/.catalog; mkdir -p "$RUN"; rm -f "$RUN/.shas"; v2fly_names; r=$?; rm -rf "$RUN"; exit $r; fi
# one run at a time (cron, the daemon's --missing, LuCI): they share the work files and the sets
if command -v flock >/dev/null 2>&1; then exec 9> "$RUN/.lock"; flock 9; fi
RESTORE=0; MISSING=0
[ "$1" = --restore ] && { RESTORE=1; shift; }
[ "$1" = --missing ] && { MISSING=1; shift; }   # download only lists that have no data yet
ONLY=" $* "
ACCEPTED=0   # bytes the lists of this run have added (not yet seen in MemAvailable)
: > "$RUN/.targets"
[ "$RESTORE" = 1 ] || rm -f "$RUN/.shas"   # the commits are asked once per run

status() {  # status <list> <ok 0|1> <count> <kind> <target> <message> [the date of the source's commit]
	printf '{"name":"%s","ok":%s,"count":%d,"kind":"%s","target":"%s","ts":%d,"message":"%s","upstream":"%s"}\n' \
		"$1" "$([ "$2" = 1 ] && echo true || echo false)" "${3:-0}" "$4" "$5" "$(date +%s)" "$(printf '%s' "$6" | tr -d '"\\\n')" "$(printf '%s' "$7" | tr -cd '0-9TZ:-')" > "$RUN/$1.status"
}

norm_cidr() {
	grep -oE '^[[:space:]]*[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?' | tr -d ' \t' | \
		awk -F'[./]' '$1<=255 && $2<=255 && $3<=255 && $4<=255 && (NF<5 || $5<=32) && $1!=0 && $1!=127 && $1<224' | sort -u
}

norm_domains() {
	tr 'A-Z' 'a-z' | sed 's/\r$//' | awk '
		/^[[:space:]]*($|#|!|\[)/ { next }
		{ sub(/[[:space:]]+#.*$/, "") }
		/^(server|ipset|nftset|address|local)=\// { n = split($0, a, "/"); for (i = 2; i < n; i++) print a[i]; next }
		/^\|\|/ { d = substr($0, 3); sub(/[\^$].*$/, "", d); print d; next }
		/^(0\.0\.0\.0|127\.0\.0\.1|::1?)[[:space:]]/ { print $2; next }
		# v2fly/geosite text (runetfreedom russia-blocked-geosite, as stock uses): domain:x / full:x are
		# domains (an attribute tail " @ads" / ":@ads" dropped); keyword/regexp/include/ext are not
		/^[[:space:]]*(include|keyword|regexp|ext):/ { next }
		/^[[:space:]]*(domain|full):/ { d = $0; sub(/^[[:space:]]*(domain|full):/, "", d); sub(/(:@|[[:space:]]).*$/, "", d); print d; next }
		{ print $1 }' | sed 's/^\*\.//; s/^\.//; s/\.$//' | \
		grep -E '^[a-z0-9_]([a-z0-9_.-]*[a-z0-9])?\.[a-z][a-z0-9-]*[a-z0-9]$|^[a-z0-9_]([a-z0-9_.-]*[a-z0-9])?\.[a-z]{2,}$' | \
		grep -vE '^(localhost|local|broadcasthost)$' | sort -u
}

# more IPv4 lines than anything else -> cidr
detect_kind() {
	_ip=$(grep -cE '^[[:space:]]*[0-9]{1,3}(\.[0-9]{1,3}){3}' "$1")
	_all=$(grep -cvE '^[[:space:]]*($|#|!)' "$1")
	[ "$_all" -gt 0 ] && [ $((_ip * 2)) -ge "$_all" ] && echo cidr || echo domain
}

# up to 3 attempts 5 s apart: the daemon starts us right after a reload that may restart dnsmasq,
# and a name that does not resolve meanwhile is not a "transient" error for curl --retry
# RAWMAX: the biggest download this list may take (bytes); curl stops past it (exit 63: no retry)
fetch() {
	local a=0 rc
	while :; do
		curl -fsSL -m 180 --retry 2 ${RAWMAX:+--max-filesize $RAWMAX} "$1" > "$2" 2>/dev/null; rc=$?
		[ $rc = 0 ] && return 0
		[ $rc = 63 ] && return 63
		a=$((a + 1)); [ $a -ge 3 ] && return 1; sleep 5
	done
}
mb() { echo $(( $1 / 1048576 )); }   # the limit, rounded down

# a v2fly domain-list-community category with its include: lines (stock geo.sh fetch_v2fly; attribute
# filters "include:x @cn" are not applied - the whole included category is taken)
V2FLY=$(uci -q get detour.main.v2fly_base); V2FLY=${V2FLY:-https://cdn.jsdelivr.net/gh/v2fly/domain-list-community@master/data}   # lab: a copy on the PC
fetch_v2fly() {
	local queue="$1" out="$2" seen=" " nm n=0 i base rc   # $2 is saved: "set --" below replaces the arguments
	base=$(pin "$V2FLY"); V2_DATE=$(upstream_date "$V2FLY")   # every file of one category from the same commit
	while [ -n "$queue" ]; do
		set -- $queue; nm=$1; shift; queue="$*"
		case "$nm" in *[!a-z0-9!._-]*|'') continue ;; esac
		case "$seen" in *" $nm "*) continue ;; esac
		seen="$seen$nm "; n=$((n + 1)); [ $n -gt 200 ] && break
		fetch "$base/$nm" "$RUN/.v2.part" || { rc=$?; rm -f "$RUN/.v2.part"; return $rc; }
		for i in $(tr 'A-Z' 'a-z' < "$RUN/.v2.part" | sed -n 's/^[[:space:]]*include:\([a-z0-9!._-]*\).*/\1/p'); do queue="$queue $i"; done
		cat "$RUN/.v2.part" >> "$out"; echo >> "$out"
	done
	rm -f "$RUN/.v2.part"
}

handle_list() {
	local s=$1 en pol kind minl file urls tgt pid raw n fail=0 msg skip up= rc add
	config_get_bool en "$s" enabled 1
	config_get pol "$s" policy
	config_get kind "$s" kind auto
	config_get minl "$s" min_lines 10
	config_get file "$s" file
	config_get urls "$s" url
	case "$minl" in ''|*[!0-9]*) minl=10 ;; esac
	if [ "$en" != 1 ]; then rm -f "$RUN/$s.data"; status "$s" 1 0 "$kind" "-" "disabled"; return; fi
	pid=$(uci -q get detour."$pol".id)
	[ "$(uci -q get detour."$pol")" = policy ] && [ -n "$pid" ] || { status "$s" 0 0 "$kind" "-" "unknown policy '$pol'"; return; }
	tgt=p$pid
	[ "$MISSING" = 1 ] && { [ -s "$RUN/$s.data" ] || [ -s "$SNAP/$s.snap" ]; } && skip=1 || skip=0
	if [ "$RESTORE" = 1 ] || [ "$skip" = 1 ] || { [ "$ONLY" != "  " ] && [ "${ONLY#* $s }" = "$ONLY" ]; }; then
		# no download: keep RAM data, else take the snapshot
		[ -s "$RUN/$s.data" ] || { [ -s "$SNAP/$s.snap" ] && cp "$SNAP/$s.snap" "$RUN/$s.data" && cp "$SNAP/$s.kind" "$RUN/$s.kind" 2>/dev/null; }
		[ -s "$RUN/$s.data" ] && echo "$s $tgt $(cat "$RUN/$s.kind" 2>/dev/null || echo cidr)" >> "$RUN/.targets"
		[ "$RESTORE" = 1 ] && [ -s "$RUN/$s.data" ] && status "$s" 1 "$(wc -l < "$RUN/$s.data")" "$(cat "$RUN/$s.kind" 2>/dev/null)" "$tgt" "restored from snapshot"
		return
	fi
	raw="$RUN/$s.raw"
	: > "$raw"
	RAWMAX=$(/usr/sbin/detour lists-mem rawmax "$ACCEPTED" 2>/dev/null); case "$RAWMAX" in ''|*[!0-9]*) RAWMAX= ;; esac
	for u in $urls; do
		case "$u" in
		v2fly:*) fetch_v2fly "${u#v2fly:}" "$raw"; rc=$?; up=${up:-$V2_DATE} ;;
		*) fetch "$(pin "$u")" "$raw.part"; rc=$?; [ $rc = 0 ] && cat "$raw.part" >> "$raw"; rm -f "$raw.part"
		   up=${up:-$(upstream_date "$u")} ;;
		esac
		[ $rc = 63 ] && { fail=1; msg="download too big for the memory: over $(mb "$RAWMAX") MB"; }
		[ $rc != 0 ] && [ $rc != 63 ] && { fail=1; msg="download failed: $u"; }
		echo >> "$raw"
	done
	[ -n "$file" ] && { [ -r "$file" ] && cat "$file" >> "$raw" || { fail=1; msg="file missing: $file"; }; }
	# several sources (and v2fly includes) add up: the whole text must fit too
	[ "$fail" = 0 ] && [ -n "$RAWMAX" ] && [ "$(wc -c < "$raw")" -gt "$RAWMAX" ] && { fail=1; msg="download too big for the memory: over $(mb "$RAWMAX") MB"; }
	[ "$fail" = 1 ] && : > "$raw"   # nothing of a failed download is normalised (sorting holds it in memory again)
	[ "$kind" = auto ] && kind=$(detect_kind "$raw")
	if [ "$kind" = cidr ]; then norm_cidr < "$raw" > "$RUN/$s.new"; else norm_domains < "$raw" > "$RUN/$s.new"; fi
	rm -f "$raw"
	n=$(wc -l < "$RUN/$s.new")
	[ "$fail" = 0 ] && [ "$n" -lt "$minl" ] && { fail=1; msg="only $n entries (minimum $minl)"; }
	# does it fit in memory (what it adds, with what this run already let in)?
	if [ "$fail" = 0 ]; then
		if add=$(/usr/sbin/detour lists-mem check "$s" "$kind" "$n" "$tgt" "$ACCEPTED" 2>/dev/null); then
			case "$add" in ''|*[!0-9]*) add=0 ;; esac
			ACCEPTED=$((ACCEPTED + add))
		else fail=1; msg=${add:-not enough memory}; fi
	fi
	if [ "$fail" = 1 ]; then
		rm -f "$RUN/$s.new"
		[ -s "$RUN/$s.data" ] || { [ -s "$SNAP/$s.snap" ] && cp "$SNAP/$s.snap" "$RUN/$s.data" && cp "$SNAP/$s.kind" "$RUN/$s.kind" 2>/dev/null; }
		status "$s" 0 "$( [ -s "$RUN/$s.data" ] && wc -l < "$RUN/$s.data" || echo 0)" "$kind" "$tgt" "$msg; previous data kept" "$up"
		logger -t detour "list $s: $msg; previous data kept"
	else
		mv "$RUN/$s.new" "$RUN/$s.data"; echo "$kind" > "$RUN/$s.kind"
		if [ "$n" -le "$MAXSNAP" ]; then cp "$RUN/$s.data" "$SNAP/$s.snap.tmp" && mv "$SNAP/$s.snap.tmp" "$SNAP/$s.snap"; echo "$kind" > "$SNAP/$s.kind"
		else rm -f "$SNAP/$s.snap"; msg="(too big for a flash snapshot)"; fi
		status "$s" 1 "$n" "$kind" "$tgt" "updated $msg" "$up"
	fi
	[ -s "$RUN/$s.data" ] && echo "$s $tgt $(cat "$RUN/$s.kind" 2>/dev/null || echo "$kind")" >> "$RUN/.targets"
}

config_load detour
config_foreach handle_list list
# a full download run (the nightly one, "update all"): the names of the v2fly categories too
[ "$RESTORE" = 0 ] && [ "$MISSING" = 0 ] && [ "$ONLY" = "  " ] && v2fly_names

# --- CIDR: one transaction per set (flush + add) -------------------------------------------
nft -t list table $T >/dev/null 2>&1 || { logger -t detour "lists: table $T missing"; exit 1; }
sets="$(nft -t list table $T | sed -n 's/^[[:space:]]*set \(lst4_p[0-9]*\) {.*/\1/p')"
for set in $sets; do
	tgt=${set#lst4_}
	f="$RUN/.$set.nft"
	echo "flush set $T $set" > "$f"
	awk -v t="$tgt" '$2 == t && $3 == "cidr" { print $1 }' "$RUN/.targets" | while read -r s; do
		awk -v set="$set" -v T="$T" 'NR % 1000 == 1 { if (NR > 1) print " }"; printf "add element %s %s { %s", T, set, $0; next } { printf ", %s", $0 } END { if (NR) print " }" }' "$RUN/$s.data"
	done >> "$f"
	nft -f "$f" || logger -t detour "lists: loading $set failed"
	rm -f "$f"
done

# --- domains: dnsmasq files (restart only when something changed) -------------------------
changed=0
dirs=""
for d in $(uci -X show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^.=]*\)=dnsmasq$/\1/p'); do
	c=$(uci -q get dhcp."$d".confdir); c=${c%%,*}
	dirs="$dirs ${c:-/tmp/dnsmasq.$d.d}"
done
# "Block" policies (action block): their domain lists answer "no such name" instead of filling a set;
# "Directly" policies (action direct): only the IPv4 set, no AAAA suppression (they are not tunnelled)
BLOCKP=" " DIRECTP=" "
for b in $(uci -X show detour 2>/dev/null | sed -n 's/^detour\.\([^.=]*\)=policy$/\1/p'); do
	case "$(uci -q get detour."$b".action)" in
		block) BLOCKP="${BLOCKP}p$(uci -q get detour."$b".id) " ;;
		direct) DIRECTP="${DIRECTP}p$(uci -q get detour."$b".id) " ;;
	esac
done
for dir in $dirs; do
	mkdir -p "$dir"
	keep=" "
	while read -r s tgt kind; do
		[ "$kind" = domain ] || continue
		keep="$keep$s "
		out="$dir/detour-list-$s.conf"
		drc=0; [ "${DIRECTP#* $tgt }" != "$DIRECTP" ] && drc=1
		set4=dom4_$tgt; set6=dom6_$tgt; [ "$drc" = 1 ] && set6=""
		blk=0; [ "${BLOCKP#* $tgt }" != "$BLOCKP" ] && blk=1
		awk -v s4="$set4" -v s6="$set6" -v blk="$blk" -v direct="$drc" '
			{ d[++n] = $0 }
			END {
				for (i = 1; i <= n; i += 40) {
					l = d[i]; for (j = i + 1; j < i + 40 && j <= n; j++) l = l "/" d[j]
					if (blk) { printf "address=/%s/\n", l; continue }
					printf "nftset=/%s/4#inet#detour#%s%s\n", l, s4, (s6 != "" ? ",6#inet#detour#" s6 : "")
					if (!direct) printf "address=/%s/100::\n", l   # AAAA -> the discard prefix (see dns.uc)
				}
			}' "$RUN/$s.data" > "$out.tmp"
		if cmp -s "$out.tmp" "$out"; then rm -f "$out.tmp"; else mv "$out.tmp" "$out"; changed=1; fi
	done < "$RUN/.targets"
	for f in "$dir"/detour-list-*.conf; do
		[ -e "$f" ] || continue
		s=${f##*/detour-list-}; s=${s%.conf}
		[ "${keep#* $s }" = "$keep" ] && { rm -f "$f"; changed=1; }
	done
done
# at boot (--restore, before dnsmasq has started) dnsmasq reads the files itself; otherwise one restart at a time,
# never left stopped (dnsmasq-restart)
if [ "$changed" = 1 ]; then
	[ "$RESTORE" = 1 ] && ! pidof dnsmasq >/dev/null || /usr/libexec/detour/dnsmasq-restart
fi
# snapshots of lists that are gone from the config
for f in "$SNAP"/*.snap; do
	[ -e "$f" ] || continue
	s=${f##*/}; s=${s%.snap}
	[ "$(uci -q get detour."$s")" = list ] || rm -f "$f" "$SNAP/$s.kind" "$RUN/$s.data" "$RUN/$s.kind" "$RUN/$s.status"
done
exit 0
