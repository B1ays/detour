#!/usr/bin/ucode
// The routing core only (boot, shutdown, upgrade, uninstall): imports nothing but the core modules, so a
// fault in an optional feature (engines, WARP, subscriptions, import, ...) never stops fw-start/fw-stop/purge.
//   fw start | stop | purge
'use strict';

import * as fw from 'detour.fw';

switch (ARGV[0]) {
case 'start': {
	const r = fw.start();
	for (let e in r.errors) warn('detour: ' + e + '\n');
	exit(r.ok ? 0 : 1);
}
case 'stop':
	fw.stop(true);
	exit(0);
case 'purge':
	fw.purge();
	exit(0);
default:
	warn('usage: fw start|stop|purge\n');
	exit(1);
}
