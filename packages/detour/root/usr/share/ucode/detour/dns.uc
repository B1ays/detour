// Detour + dnsmasq(-full): domain lists -> nftset into dom4_pN/dom6_pN, AAAA suppression for policy
// domains (first version: no v6 tunnelling), router DNS via a policy with a direct encrypted fallback.
'use strict';

import * as fs from 'fs';
import { cursor } from 'uci';
import { run, RUN } from 'detour.core';

export const SERVERS = RUN + '/dns.servers';
const CONF = 'detour.conf';

// conf-dir of every dnsmasq instance (the service is jailed: files must live there)
export function confdirs() {
	const c = cursor();
	const out = [];
	c.foreach('dhcp', 'dnsmasq', function(s) {
		let d = s.confdir ?? sprintf('/tmp/dnsmasq.%s.d', s['.name']);
		d = split(d, ',')[0];
		if (substr(d, 0, 1) == '/') push(out, d);
	});
	return out;
};

function chunks(list, n) {
	const out = [];
	for (let i = 0; i < length(list); i += n) push(out, slice(list, i, i + n));
	return out;
}

export const DISCARD6 = '100::';

// the provider's DNS servers (netifd writes them here for the WAN), IPv4 only
export function wan_dns() {
	const out = [];
	for (let l in split(fs.readfile('/tmp/resolv.conf.d/resolv.conf.auto') ?? '', '\n')) {
		const m = match(l, /^nameserver ([0-9.]+)$/);
		if (m && index(out, m[1]) < 0) push(out, m[1]);
	}
	return out;
};

// server names the enabled engines dial ({ host, via_dev }): sing-box "server", Xray vnext/servers
// "address", read straight from the engines' outbound files (this module is on the early-boot path of
// detour-fw and imports no engine code)
function engine_hosts() {
	const c = cursor(), out = [], seen = {};
	c.foreach('detour', 'engine', function(s) {
		if (s.enabled == '0' || !s.outbound) return;
		let via_dev = null;
		if (s.via) { const x = c.get_all('detour', s.via); if (x?.['.type'] == 'exit') via_dev = x.device ?? x.iface ?? s.via; }
		let o;
		try { o = json(fs.readfile(s.outbound) ?? 'null'); } catch (e) { return; }
		if (type(o?.outbounds) == 'array') o = o.outbounds;
		for (let x in ((type(o) == 'array') ? o : [ o ])) {
			if (type(x) != 'object') continue;
			const hs = [ x.server ];
			for (let v in x.settings?.vnext ?? []) push(hs, v?.address);
			for (let v in x.settings?.servers ?? []) push(hs, v?.address);
			for (let h in hs) {
				if (type(h) != 'string' || !match(h, /^[A-Za-z0-9.-]+\.[A-Za-z][A-Za-z0-9-]*$/)) continue;   // names, not IPs
				const k = lc(h) + '|' + (via_dev ?? '');
				if (!seen[k]) { seen[k] = true; push(out, { host: lc(h), via_dev }); }
			}
		}
	});
	return out;
}

// DNS of the proxy engines' own servers, around the tunnels: an engine chained to another exit asks
// through that exit (dnsmasq "@device"), the others ask the provider's DNS directly. Without this, with
// the router's DNS through the tunnel, an engine carrying that tunnel needs itself to find its server
// (the BE7000: st_main restarted and stayed down; the subscription's servers were in the same trap).
function engine_server_lines(cfg) {
	const L = [], wan = wan_dns(), tun = cfg.main.dns_servers[0] ?? '1.1.1.1';
	const direct = length(wan) ? wan : map(cfg.main.dns_bootstrap, (b) => split(b, ':')[0]);
	for (let h in engine_hosts()) {
		if (h.via_dev) push(L, sprintf('server=/%s/%s@%s', h.host, tun, h.via_dev));
		else for (let s in direct) push(L, sprintf('server=/%s/%s', h.host, s));
	}
	return L;
}

export function render_conf(cfg) {
	const L = [ '# generated by detour - do not edit', ...engine_server_lines(cfg) ];
	for (let p in cfg.policies) {
		if (!p.enabled || !length(p.domains)) continue;
		for (let ch in chunks(p.domains, 40)) {
			const doms = join('/', ch);
			// "Block": no answer at all ("no such name", A and AAAA) - apps give up at once
			if (p.block) { push(L, sprintf('address=/%s/', doms)); continue; }
			// "Directly": the addresses mark the policy's place in classify; no AAAA suppression (not tunnelled)
			if (p.direct) { push(L, sprintf('nftset=/%s/4#inet#detour#dom4_p%d', doms, p.id)); continue; }
			push(L, sprintf('nftset=/%s/4#inet#detour#dom4_p%d,6#inet#detour#dom6_p%d', doms, p.id, p.id));
			// AAAA suppressed (A-7), A answers unchanged. Not "::": that is the host itself - the router's
			// own curl (lists, subscriptions, notifications) tried [::]:443, reached uhttpd and failed on its
			// certificate instead of falling back to IPv4. 100:: is the discard prefix (RFC 6666), routed
			// unreachable here (net.discard6), so a v6 attempt fails at once and the client uses IPv4.
			push(L, sprintf('address=/%s/%s', doms, DISCARD6));
		}
	}
	return join('\n', L) + '\n';
};

// returns true when any instance's file changed (caller restarts dnsmasq: conf-dir is not re-read on HUP)
export function write_conf(cfg) {
	const text = render_conf(cfg);
	let changed = false;
	for (let d in confdirs()) {
		fs.mkdir(d);
		const f = d + '/' + CONF;
		if (fs.readfile(f) != text) {
			fs.writefile(f, text);
			changed = true;
		}
	}
	return changed;
};

export function remove_conf() {
	let changed = false;
	for (let d in confdirs()) {
		if (fs.access(d + '/' + CONF)) { fs.unlink(d + '/' + CONF); changed = true; }
		// the big lists' files (lists-update) name sets of the same table; lists-update --restore writes them again
		for (let f in fs.glob(d + '/detour-list-*.conf') ?? []) { fs.unlink(f); changed = true; }
	}
	return changed;
};

// router DNS through the tunnel: dnsmasq reads its upstreams only from our servers-file
// (re-read on SIGHUP, no restart). Returns true when the UCI side changed (needs a restart).
export function ensure_uci(enabled) {
	const c = cursor();
	let changed = false;
	c.foreach('dhcp', 'dnsmasq', function(s) {
		const n = s['.name'];
		if (enabled) {
			if (s.serversfile != SERVERS) { c.set('dhcp', n, 'serversfile', SERVERS); changed = true; }
			if (s.noresolv != '1') { c.set('dhcp', n, 'noresolv', '1'); changed = true; }
			if (s.detour_managed != '1') { c.set('dhcp', n, 'detour_managed', '1'); changed = true; }
		}
		else if (s.detour_managed == '1') {
			c.delete('dhcp', n, 'serversfile');
			c.delete('dhcp', n, 'noresolv');
			c.delete('dhcp', n, 'detour_managed');
			changed = true;
		}
	});
	if (changed) c.commit('dhcp');
	return changed;
};

// mode: 'tunnel' | 'fallback' | 'encrypted' (= the fallback's resolver, permanently)
export function write_servers(cfg, mode) {
	fs.mkdir(RUN);
	let L = [];
	if (mode == 'fallback' || mode == 'encrypted') {
		// the encrypted resolver (dnsproxy, direct); without it the provider's DNS, so names still resolve
		if (fs.access('/usr/bin/dnsproxy')) push(L, sprintf('server=127.0.0.1#%d', cfg.main.dns_fallback_port));
		else for (let s in wan_dns()) push(L, 'server=' + s);
	}
	else
		for (let s in cfg.main.dns_servers) push(L, 'server=' + s);
	const text = join('\n', L) + '\n';
	if (fs.readfile(SERVERS) == text) return false;
	fs.writefile(SERVERS, text);
	return true;
};

export function hup() { return run('killall -HUP dnsmasq'); };
// one at a time, and never left stopped (usr/libexec/detour/dnsmasq-restart)
export function restart() { return run('/usr/libexec/detour/dnsmasq-restart'); };

// the router's upstream resolvers must go through the DNS policy
export function prepare(cfg) {
	if (cfg.main.dns != 'tunnel') return;
	for (let p in cfg.policies)
		if (p.name == cfg.main.dns_policy)
			for (let s in cfg.main.dns_servers)
				if (index(p.dst4, s) < 0) push(p.dst4, s);
};
