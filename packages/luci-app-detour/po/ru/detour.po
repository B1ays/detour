msgstr "шифрованный DNS"

msgid "choose it in «Router DNS» on the Settings page"
msgstr "выберите его в «DNS роутера» на странице «Настройки»"

msgid "WARP registration"
msgstr "регистрация WARP"

msgid "register WARP again here (a new device)"
msgstr "зарегистрируйте WARP здесь заново (новое устройство)"

