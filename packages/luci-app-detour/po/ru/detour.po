msgstr "направление «%s» не поддерживается"

msgid "port rules «block» are not part of Detour for OpenWrt"
msgstr "правила портов «блокировать» не входят в Detour для OpenWrt"

msgid "port rules «direct» are not part of Detour for OpenWrt"
msgstr "правила портов «напрямую» не входят в Detour для OpenWrt"

msgid "not in the catalogue (your own or an ODoH resolver) - set it in «Router DNS» on the Settings page"
msgstr "нет в каталоге (свой сервер или ODoH) — укажите его в «DNS роутера» на странице «Настройки»"

msgid "%s: this address has no DHCP reservation, the device is unknown"
msgstr "%s: у этого адреса нет закреплённого DHCP, устройство неизвестно"

msgid "a device past VPN"
msgstr "устройство мимо VPN"

msgid "a whole device through VPN"
msgstr "всё устройство через VPN"

msgid "panel password"
msgstr "пароль панели"

msgid "LuCI uses the router's root password"
msgstr "LuCI использует пароль root роутера"

msgid "2FA secret"
msgstr "секрет 2FA"

msgid "set up two-factor login again (luci-plugin-2fa, a new QR code)"
msgstr "настройте двухфакторный вход заново (luci-plugin-2fa, новый QR-код)"

msgid "home access server"
msgstr "сервер доступа домой"

msgid "set it up again (new keys)"
msgstr "настройте заново (новые ключи)"

msgid "access schedules"
msgstr "расписания доступа"

msgid "use firewall rules with a time window"
msgstr "используйте правила фаервола с временем действия"

msgid "install the zapret package and choose a strategy"
msgstr "установите пакет zapret и выберите стратегию"

msgid "split DNS for Russian domains"
msgstr "раздельный DNS для российских доменов"

msgid "not needed here: the router resolves names through dnsmasq"
msgstr "здесь не нужен: роутер разрешает имена через dnsmasq"

