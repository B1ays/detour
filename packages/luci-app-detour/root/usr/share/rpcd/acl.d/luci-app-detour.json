{
	"luci-app-detour": {
		"description": "Grant access to Detour's state (read-only: no settings, no secrets)",
		"read": {
			"ubus": {
				"detour": [
					"status",
					"exits_info",
					"sub_state",
					"traffic",
					"devices",
					"catalog_names",
					"dns_providers",
					"rates",
					"rates_history"
				],
				"luci": [
					"getFeatures"
				],
				"luci-rpc": [
					"getHostHints",
					"getDHCPLeases"
				]
			},
			"uci": [
				"dhcp"
			]
		}
	},
	"luci-app-detour-admin": {
		"description": "Grant full access to Detour: its settings (with keys, the Telegram token, subscription addresses), the DNS log, backups, every action",
		"read": {
			"ubus": {
				"detour": [
					"site_explain",
					"dns_log",
					"pkg_list",
					"pkg_job"
				]
			},
			"uci": [
				"detour",
				"network",
				"dhcp"
			],
			"file": {
				"/tmp/detour-backup.bin": [
					"read"
				],
				"/tmp/detour-logs.tar.gz": [
					"read"
				],
				"/etc/detour/before-restore.bin": [
					"read"
				]
			}
		},
		"write": {
			"ubus": {
				"detour": [
					"pin",
					"unpin",
					"reload",
					"notify_test",
					"engine_add",
					"warp_register",
					"warp_unregister",
					"backup_create",
					"backup_check",
					"backup_restore",
					"lists_update",
					"sub_update",
					"exit_check",
					"exit_wake",
					"sub_check",
					"exit_remove",
					"exit_pick",
					"exit_config_get",
					"exit_config_set",
					"exit_set_link",
					"exit_parse",
					"exit_add",
					"exit_export",
					"exit_speed",
					"sub_speed",
					"exit_diag",
					"exit_set_via",
					"site_check",
					"dns_watch",
					"dns_watch_stop",
					"catalog_refresh",
					"pkg_run",
					"log_level",
					"logs_archive"
				]
			},
			"uci": [
				"detour",
				"network",
				"dhcp"
			],
			"file": {
				"/tmp/detour-restore.bin": [
					"write"
				],
				"/tmp/detour-backup.bin": [
					"write"
				]
			}
		}
	}
}
